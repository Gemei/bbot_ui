class BrowserScreen(Screen):
    """Browse live scans and archives."""

    BINDINGS = [
        Binding("q", "app.quit", "Quit"),
        Binding("escape", "app.quit", "Quit", show=False),
        Binding("r", "refresh", "Refresh"),
        Binding("slash", "focus_filter", "Filter"),
        Binding("1", "show_scans", "Scans"),
        Binding("2", "show_archives", "Archives"),
        Binding("a", "archive", "Archive"),
        Binding("u", "unarchive", "Unarchive"),
        Binding("d", "delete", "Delete"),
        Binding("c", "copy_row", "Copy row"),
        # Many terminals send uppercase C for Shift+C; bind both + priority
        Binding("shift+c,C,ctrl+shift+c", "copy_table", "Copy table", priority=True),
        Binding("question_mark", "help", "Help"),
        Binding("enter", "open_row", "Open", show=False),
    ]

    mode = reactive("scans")  # "scans" | "archives"

    def __init__(self, scans_dir: Path, refresh_interval: float = 3.0):
        super().__init__()
        self.scans_dir = scans_dir
        self.refresh_interval = refresh_interval
        self.scans: List[Dict[str, Any]] = []
        self.archives: List[Dict[str, Any]] = []
        self.rows: List[Dict[str, Any]] = []
        self.filter_query = ""
        self._timer = None
        self._loading = False
        # Cache: path -> (mtime, size, summary_tuple)
        self._summary_cache: Dict[str, tuple] = {}

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        with Vertical(id="browser-root"):
            yield Static("", id="browser-title")
            with Horizontal(id="browser-toolbar"):
                yield Static("[b]1[/] Scans  [b]2[/] Archives", id="mode-hint")
                yield Input(placeholder="Filter by name…  (/)", id="browser-filter")
                yield Button("Refresh", id="btn-refresh", variant="default")
            yield SelectableTable(id="browser-table")
            yield Static("", id="browser-status")
        yield Footer()

    def on_mount(self) -> None:
        table = self.query_one("#browser-table", SelectableTable)
        table.add_columns("Name", "Status", "Events", "Vulns", "Findings", "Modified")
        self._set_title()
        self.action_refresh()
        self._timer = self.set_interval(self.refresh_interval, self._auto_refresh)

    def on_unmount(self) -> None:
        if self._timer:
            self._timer.stop()

    def _set_title(self) -> None:
        path = escape_markup(str(self.scans_dir))
        mode = "SCANS" if self.mode == "scans" else "ARCHIVES"
        self.query_one("#browser-title", Static).update(
            f"[bold]BBOT[/]  [dim]{path}[/]  ·  [cyan]{mode}[/]"
        )

    def watch_mode(self, mode: str) -> None:
        self._set_title()
        self._rebuild_table()

    def action_show_scans(self) -> None:
        # watch_mode rebuilds the table once
        self.mode = "scans"

    def action_show_archives(self) -> None:
        self.mode = "archives"
        # Always refresh archive list when switching here (quiet path may skip it)
        if not self._loading:
            self._loading = True
            self.query_one("#browser-status", Static).update("[dim]Loading archives…[/]")
            self._load_data(quiet=True, running_only=False, archives_only=True)

    def action_focus_filter(self) -> None:
        self.query_one("#browser-filter", Input).focus()

    def action_help(self) -> None:
        self.app.push_screen(HelpScreen())

    def action_refresh(self) -> None:
        if self._loading:
            return
        self._loading = True
        self.query_one("#browser-status", Static).update("[dim]Loading…[/]")
        self._load_data()

    def _auto_refresh(self) -> None:
        if self._loading or self.mode != "scans":
            return
        # Quiet refresh only re-reads RUNNING (or unknown) scans; finished stay cached
        self._load_data(quiet=True, running_only=True)

    @work(thread=True, exclusive=True)
    def _load_data(
        self,
        quiet: bool = False,
        running_only: bool = False,
        archives_only: bool = False,
    ) -> None:
        try:
            # Snapshot list for worker (avoid racing with main thread mutations)
            prior = list(self.scans) if running_only else None
            if archives_only:
                scans = list(self.scans)
                archives = self._discover_archives()
            else:
                scans = self._discover_scans(running_only=running_only, prior=prior)
                if quiet and running_only:
                    archives = list(self.archives)
                else:
                    archives = self._discover_archives()
            self.app.call_from_thread(self._apply_data, scans, archives, quiet)
        except Exception as e:
            self.app.call_from_thread(self._apply_data_error, str(e))

    def _apply_data(self, scans, archives, quiet: bool) -> None:
        self.scans = scans
        self.archives = archives
        self._loading = False
        self._rebuild_table()
        if not quiet:
            self.notify("Refreshed", timeout=1.5)

    def _apply_data_error(self, message: str) -> None:
        self._loading = False
        try:
            self.query_one("#browser-status", Static).update(
                f"[red]Load failed:[/] {escape_markup(message)[:80]}"
            )
        except Exception:
            pass
        self.notify(f"Refresh failed: {message}", severity="error", timeout=4)

    def _discover_scans(
        self,
        running_only: bool = False,
        prior: Optional[List[Dict[str, Any]]] = None,
    ) -> List[Dict[str, Any]]:
        results = []
        prior_map = {s["name"]: s for s in (prior or [])}
        try:
            dirs = sorted(
                [d for d in self.scans_dir.iterdir() if d.is_dir() and not d.name.startswith(".")],
                key=lambda p: p.name,
            )
        except Exception:
            return results

        for scan_dir in dirs:
            output_json = scan_dir / "output.json"
            if not output_json.exists():
                continue
            name = scan_dir.name
            if running_only and name in prior_map:
                prev = prior_map[name]
                if prev.get("status") in ("FINISHED", "INTERRUPTED"):
                    # Keep cached row unless file grew
                    try:
                        st = output_json.stat()
                        key = str(output_json)
                        cached = self._summary_cache.get(key)
                        if cached and cached[0] == st.st_mtime and cached[1] == st.st_size:
                            results.append(prev)
                            continue
                    except Exception:
                        results.append(prev)
                        continue
            try:
                status, events, vulns, findings, modified, modified_ts = self._scan_summary(output_json)
            except Exception:
                status, events, vulns, findings, modified, modified_ts = "UNKNOWN", 0, 0, 0, "?", 0.0
            results.append({
                "kind": "scan",
                "name": name,
                "path": scan_dir,
                "status": status,
                "event_count": events,
                "vuln_count": vulns,
                "finding_count": findings,
                "modified": modified,
                "modified_ts": modified_ts,
            })
        # Newest scans first
        results.sort(key=lambda r: r.get("modified_ts") or 0, reverse=True)
        return results

    def _scan_summary(self, output_json: Path) -> tuple:
        """Return status, counts, display date, and mtime (cached by mtime/size)."""
        st = output_json.stat()
        key = str(output_json)
        cached = self._summary_cache.get(key)
        if cached and cached[0] == st.st_mtime and cached[1] == st.st_size:
            summary = cached[2]
            # Older cache entries lacked mtime as 6th field
            if isinstance(summary, tuple) and len(summary) == 5:
                return (*summary, cached[0])
            return summary

        modified = datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d %H:%M")
        size = st.st_size
        events = vulns = findings = 0
        last_status = "UNKNOWN"

        with open(output_json, "r", encoding="utf-8", errors="ignore") as f:
            if size > 2_000_000:
                # Large files: head + tail sample (much faster)
                head = f.read(120_000)
                f.seek(max(0, size - 60_000))
                tail = f.read()
                sample = head + "\n" + tail
                sample_events = 0
                for line in sample.splitlines():
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        ev = json.loads(line)
                    except Exception:
                        continue
                    t = ev.get("type", "")
                    if t == "SCAN":
                        data = ev.get("data_json") or ev.get("data") or {}
                        stt = data.get("status")
                        if stt:
                            last_status = stt
                    elif t == "VULNERABILITY":
                        vulns += 1
                        sample_events += 1
                    elif t == "FINDING":
                        findings += 1
                        sample_events += 1
                    elif t:
                        sample_events += 1
                scale = max(1.0, size / max(1, len(sample.encode("utf-8", errors="ignore"))))
                events = int(sample_events * scale)
                vulns = int(vulns * scale)
                findings = int(findings * scale)
            else:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        ev = json.loads(line)
                    except Exception:
                        continue
                    t = ev.get("type", "")
                    if t == "SCAN":
                        data = ev.get("data_json") or ev.get("data") or {}
                        stt = data.get("status")
                        if stt:
                            last_status = stt
                    elif t == "VULNERABILITY":
                        vulns += 1
                        events += 1
                    elif t == "FINDING":
                        findings += 1
                        events += 1
                    elif t:
                        events += 1

        if last_status == "RUNNING":
            try:
                import psutil
                path_str = str(output_json.resolve())
                open_found = False
                for proc in psutil.process_iter(["pid"]):
                    try:
                        for of in proc.open_files():
                            if of.path == path_str:
                                open_found = True
                                break
                    except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess):
                        continue
                    if open_found:
                        break
                if not open_found:
                    last_status = "INTERRUPTED"
            except Exception:
                pass

        summary = (last_status, events, vulns, findings, modified, st.st_mtime)
        self._summary_cache[key] = (st.st_mtime, st.st_size, summary)
        return summary

    def _discover_archives(self) -> List[Dict[str, Any]]:
        results = []
        try:
            files = list(self.scans_dir.glob("*.zip"))
        except Exception:
            return results
        for archive_path in files:
            if archive_path.name.startswith("."):
                continue
            stats = get_archive_stats(archive_path)
            if not stats:
                continue
            size_mb = stats["size"] / (1024 * 1024)
            size_str = f"{stats['size'] / 1024:.1f} KB" if size_mb < 1 else f"{size_mb:.1f} MB"
            try:
                modified_ts = archive_path.stat().st_mtime
            except Exception:
                modified_ts = 0.0
            results.append({
                "kind": "archive",
                "name": archive_path.name[:-4],
                "path": archive_path,
                "status": "ARCHIVED",
                "event_count": stats.get("event_count", 0),
                "vuln_count": stats.get("vuln_count", 0),
                "finding_count": stats.get("finding_count", 0),
                "modified": stats.get("date", size_str),
                "modified_ts": modified_ts,
                "size": size_str,
            })
        # Newest archives first
        results.sort(key=lambda r: r.get("modified_ts") or 0, reverse=True)
        return results

    def _filtered_rows(self) -> List[Dict[str, Any]]:
        src = self.scans if self.mode == "scans" else self.archives
        q = self.filter_query.strip().lower()
        if not q:
            return list(src)
        return [r for r in src if q in r["name"].lower()]

    def _rebuild_table(self) -> None:
        table = self.query_one("#browser-table", SelectableTable)
        # Preserve selection by name (indices shift when sorting newest-first)
        selected_name = None
        try:
            if self.rows and table.cursor_row is not None and 0 <= table.cursor_row < len(self.rows):
                selected_name = self.rows[table.cursor_row].get("name")
        except Exception:
            selected_name = None

        table.clear()
        self.rows = self._filtered_rows()

        restore_idx = 0
        for i, row in enumerate(self.rows):
            if selected_name and row.get("name") == selected_name:
                restore_idx = i

            status = row.get("status", "?")
            if status == "RUNNING":
                st = Text("● RUNNING", style="bold green")
            elif status == "FINISHED":
                st = Text("✓ FINISHED", style="bold blue")
            elif status == "INTERRUPTED":
                st = Text("⚠ INTERRUPTED", style="bold yellow")
            elif status == "ARCHIVED":
                st = Text("▣ ARCHIVE", style="magenta")
            else:
                st = Text(str(status), style="dim")

            vulns = row.get("vuln_count", 0)
            findings = row.get("finding_count", 0)
            vcell = Text(f"⚠ {vulns}", style="bold red") if vulns else Text(str(vulns), style="dim")
            fcell = Text(f"⚠ {findings}", style="bold yellow") if findings else Text(str(findings), style="dim")

            table.add_row(
                Text(row["name"], no_wrap=True, overflow="ellipsis"),
                st,
                f"{row.get('event_count', 0):,}",
                vcell,
                fcell,
                str(row.get("modified", "")),
            )

        if self.rows:
            table.move_cursor(row=min(restore_idx, len(self.rows) - 1))

        n = len(self.rows)
        total = len(self.scans if self.mode == "scans" else self.archives)
        running = sum(1 for s in self.scans if s.get("status") == "RUNNING")
        self.query_one("#browser-status", Static).update(
            f"[dim]{n}/{total} shown[/]  ·  [green]{running} running[/]  ·  "
            f"Enter open · c row · C/Shift+C table · a archive · d delete · ? help"
        )

    def on_input_changed(self, event: Input.Changed) -> None:
        if event.input.id == "browser-filter":
            self.filter_query = event.value or ""
            self._rebuild_table()

    def on_button_pressed(self, event: Button.Pressed) -> None:
        if event.button.id == "btn-refresh":
            self.action_refresh()

    def _selected(self) -> Optional[Dict[str, Any]]:
        table = self.query_one("#browser-table", SelectableTable)
        if not self.rows or table.cursor_row < 0 or table.cursor_row >= len(self.rows):
            return None
        return self.rows[table.cursor_row]

    def action_open_row(self) -> None:
        row = self._selected()
        if not row:
            return
        if row["kind"] == "scan":
            # Load ScanData off the UI thread (large output.json)
            self.app.push_screen(
                ScanLoadingScreen(row["path"], self.app.scan_refresh_interval)
            )
        else:
            self.notify("Press u to unarchive, then open the restored scan", timeout=3)

    def on_data_table_row_selected(self, event: DataTable.RowSelected) -> None:
        self.action_open_row()

    def action_copy_row(self) -> None:
        """Copy highlighted browser row as TSV (or mouse selection)."""
        selected = self.get_selected_text()
        if selected:
            notify_copied(self, "selection", selected)
            return
        table = self.query_one("#browser-table", SelectableTable)
        text = table.export_selected_row_markdown()
        if not text.strip():
            # Fallback: simple markdown row
            row = self._selected()
            if row:
                text = (
                    "| Name | Status | Path |\n"
                    "| --- | --- | --- |\n"
                    f"| {row['name']} | {row.get('status', '')} | {row['path']} |\n"
                )
        notify_copied(self, "row (markdown)", text)

    def action_copy_table(self) -> None:
        """Copy entire browser table as a markdown table."""
        table = self.query_one("#browser-table", SelectableTable)
        text = table.export_all_markdown()
        n = table.row_count
        if not text.strip():
            self.notify("Nothing to copy — table is empty", severity="warning", timeout=2)
            return
        notify_copied(self, f"table ({n} rows, markdown)", text)

    def action_archive(self) -> None:
        if self.mode != "scans":
            self.notify("Switch to Scans (1) to archive", severity="warning")
            return
        row = self._selected()
        if not row:
            return
        if row.get("status") == "RUNNING":
            self.notify("Cannot archive a running scan", severity="warning")
            return

        def done(confirmed: bool) -> None:
            if not confirmed:
                return
            ok, msg = create_archive(row["path"])
            self.notify(msg, severity="information" if ok else "error", timeout=4)
            self.action_refresh()

        self.app.push_screen(
            ConfirmDialog(f"Archive '{row['name']}'?\nCompresses to ZIP and removes the folder."),
            done,
        )

    def action_unarchive(self) -> None:
        if self.mode != "archives":
            self.notify("Switch to Archives (2) to unarchive", severity="warning")
            return
        row = self._selected()
        if not row:
            return

        def done(confirmed: bool) -> None:
            if not confirmed:
                return
            ok, msg = extract_archive(row["path"])
            self.notify(msg, severity="information" if ok else "error", timeout=4)
            self.mode = "scans"
            self.action_refresh()

        self.app.push_screen(
            ConfirmDialog(f"Unarchive '{row['name']}'?\nExtracts ZIP and removes the archive."),
            done,
        )

    def action_delete(self) -> None:
        row = self._selected()
        if not row:
            return
        if row.get("status") == "RUNNING":
            self.notify("Cannot delete a running scan", severity="warning")
            return
        kind = row["kind"]
        label = "scan folder" if kind == "scan" else "archive file"

        def done(confirmed: bool) -> None:
            if not confirmed:
                return
            try:
                if kind == "scan":
                    shutil.rmtree(row["path"])
                else:
                    row["path"].unlink()
                self.notify(f"Deleted {row['name']}", timeout=3)
                self.action_refresh()
            except Exception as e:
                self.notify(f"Delete failed: {e}", severity="error", timeout=5)

        self.app.push_screen(
            ConfirmDialog(f"PERMANENTLY delete {label} '{row['name']}'?\nThis cannot be undone."),
            done,
        )


