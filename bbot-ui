def format_event_plain(event: Dict[str, Any], scan_data: Optional["ScanData"] = None) -> str:
    """Human-readable plain text for an event (good for clipboard)."""
    if not event:
        return ""
    event_type = event.get("type", "UNKNOWN")
    if scan_data:
        data = scan_data._get_event_data(event)
    else:
        data = get_event_payload(event)

    lines = [event_type, ""]
    if isinstance(data, dict):
        sev = normalize_severity(data.get("severity"))
        if event_type in ("VULNERABILITY", "FINDING") and sev:
            lines.append(f"Severity: {sev}")
        if data.get("confidence"):
            lines.append(f"Confidence: {data.get('confidence')}")
        if data.get("name"):
            lines.append(f"Name: {data.get('name')}")
        if sev or data.get("confidence") or data.get("name"):
            lines.append("")

        host = data.get("host", event.get("host", "N/A"))
        lines.append(f"Host: {host}")
        url = data.get("url") or event_url(event, data)
        if url:
            lines.append(f"URL: {url}")
        lines.append("")
        if data.get("description"):
            lines.append("Description:")
            lines.append(str(data.get("description")))
            lines.append("")
        for key in ("path", "title", "platform", "profile_name", "status_code", "http_title"):
            if data.get(key) not in (None, ""):
                lines.append(f"{key}: {data[key]}")
    else:
        # 2.x string URL / simple events
        url = event_url(event, data)
        if url:
            lines.append(f"URL: {url}")
        lines.append(f"Data: {data}")
        lines.append("")

    if event.get("host") and (not isinstance(data, dict) or not data.get("host")):
        lines.append(f"Host: {event.get('host')}")

    lines.append(f"Module: {event.get('module', 'N/A')}")
    if event.get("module_sequence"):
        lines.append(f"Module Sequence: {event.get('module_sequence')}")
    if event.get("uuid"):
        lines.append(f"UUID: {event.get('uuid')}")
    if event.get("discovery_context"):
        lines.append("")
        lines.append("Discovery Context:")
        lines.append(str(event.get("discovery_context")))
    discovery_path = event.get("discovery_path") or []
    if discovery_path:
        lines.append("")
        lines.append("Discovery Path:")
        for i, step in enumerate(discovery_path, 1):
            lines.append(f"{i}. {step}")
    host_meta = event.get("host_metadata")
    if isinstance(host_meta, dict) and host_meta:
        lines.append("")
        lines.append("Host metadata:")
        for k, v in host_meta.items():
            lines.append(f"  {k}: {v}")
    tags = event.get("tags") or []
    if tags:
        lines.append("")
        lines.append(f"Tags: {', '.join(str(t) for t in tags)}")
    if event.get("timestamp") is not None:
        lines.append("")
        lines.append(f"Timestamp: {event.get('timestamp')}")
    resolved = event.get("resolved_hosts") or []
    if resolved:
        lines.append(f"Resolved IPs: {', '.join(str(h) for h in resolved)}")
    if event.get("port") is not None:
        lines.append(f"Port: {event.get('port')}")
    return "\n".join(lines).rstrip() + "\n"


def notify_copied(screen: Screen, label: str, text: str) -> None:
    """Copy text to clipboard and show a short toast."""
    if text is None or text == "":
        screen.notify("Nothing to copy", severity="warning", timeout=2)
        return
    screen.app.copy_to_clipboard(text)
    preview = " ".join(str(text).split())
    if len(preview) > 72:
        preview = preview[:72] + "…"
    screen.notify(f"Copied {label}: {preview}", title="Clipboard", timeout=2)


def unicode_bar(value: float, maximum: float, width: int = 28) -> str:
    """Horizontal bar using block characters (works in any terminal)."""
    if maximum <= 0 or value <= 0:
        return "░" * width
    ratio = min(1.0, float(value) / float(maximum))
    filled = int(round(ratio * width))
    return "█" * filled + "░" * (width - filled)


def format_bar_chart(
    title: str,
    items: List[tuple],
    *,
    width: int = 32,
    limit: int = 15,
) -> str:
    """
    Build a labeled horizontal bar chart.

    items: list of (label, count) sorted as desired.
    """
    if not items:
        return f"{title}\n  (no data)\n"
    sliced = items[:limit]
    max_val = max(float(c) for _, c in sliced) if sliced else 1.0
    total = sum(float(c) for _, c in items) or 1.0
    label_w = min(24, max((len(str(lab)) for lab, _ in sliced), default=8))
    lines = [title, ""]
    for lab, cnt in sliced:
        lab_s = str(lab)
        if len(lab_s) > label_w:
            lab_s = lab_s[: label_w - 1] + "…"
        pct = (float(cnt) / total) * 100.0
        bar = unicode_bar(float(cnt), max_val, width=width)
        lines.append(f"  {lab_s:<{label_w}}  {bar}  {int(cnt):>6,}  ({pct:5.1f}%)")
    if len(items) > limit:
        lines.append(f"  … and {len(items) - limit} more")
    lines.append("")
    return "\n".join(lines)


def extract_scan_targets_from_data(data: Any) -> str:
    """Human-readable in-scope target(s) from a SCAN event payload."""
    names: List[str] = []

    def _add(val: Any) -> None:
        if val is None or val is False:
            return
        if isinstance(val, (list, tuple, set)):
            for item in val:
                _add(item)
            return
        if isinstance(val, dict):
            for key in ("seeds", "whitelist", "target", "targets"):
                if key in val:
                    _add(val[key])
            return
        text = str(val).strip()
        if not text or text.startswith("REGEX") or text.startswith("#"):
            return
        names.append(text)

    if isinstance(data, dict):
        _add(data.get("target"))
        _add(data.get("targets"))
        _add(data.get("seeds"))
    seen = set()
    unique: List[str] = []
    for n in names:
        if n not in seen:
            seen.add(n)
            unique.append(n)
    return ", ".join(unique[:6])


def gowitness_url_slug(url: str) -> str:
    """Approximate gowitness screenshot filename stem from a URL."""
    slug = url.strip().replace("://", "---")
    slug = re.sub(r"[^A-Za-z0-9]+", "-", slug)
    return slug.strip("-").lower()


_SHOT_EXTS = {".jpeg", ".jpg", ".png", ".webp"}
_SHOT_RENDER_CACHE: Dict[tuple, Text] = {}


def build_screenshot_index(scan_path: Path) -> Dict[str, Any]:
    """List screenshot files once (dirs can be huge)."""
    files: List[Path] = []
    seen = set()
    dirs = [
        scan_path / "gowitness" / "screenshots",
        scan_path / "screenshots",
        scan_path / "gowitness",
    ]
    for d in dirs:
        if not d.is_dir():
            continue
        try:
            for f in d.iterdir():
                if f.is_file() and f.suffix.lower() in _SHOT_EXTS:
                    key = str(f)
                    if key not in seen:
                        seen.add(key)
                        files.append(f)
        except Exception:
            continue
    by_stem = {f.stem.lower(): f for f in files}
    return {"files": files, "by_stem": by_stem}


def find_screenshot_file(
    scan_path: Path,
    url: str,
    folder: str = "",
    index: Optional[Dict[str, Any]] = None,
) -> Optional[Path]:
    """Locate a gowitness / WEBSCREENSHOT image for a URL."""
    if folder:
        p = Path(folder)
        if not p.is_absolute():
            p = scan_path / p
        if p.is_file() and p.suffix.lower() in _SHOT_EXTS:
            return p
        # Sometimes BBOT stores a relative filename only
        if p.suffix.lower() in _SHOT_EXTS:
            for parent in (
                scan_path / "gowitness" / "screenshots",
                scan_path / "screenshots",
                scan_path,
            ):
                cand = parent / p.name
                if cand.is_file():
                    return cand

    if index is None:
        index = build_screenshot_index(scan_path)
    by_stem: Dict[str, Path] = index.get("by_stem") or {}
    files: List[Path] = index.get("files") or []
    if not files:
        return None

    slug = gowitness_url_slug(url)
    if slug:
        if slug in by_stem:
            return by_stem[slug]
        # gowitness truncates long stems
        for stem, f in by_stem.items():
            if slug.startswith(stem) or stem.startswith(slug[:48]) or slug[:48] in stem:
                return f

    host = ""
    try:
        from urllib.parse import urlparse
        host = (urlparse(url).hostname or "").lower()
    except Exception:
        pass
    if host:
        host_slug = host.replace(".", "-")
        for f in files:
            low = f.stem.lower()
            if host in low or host_slug in low:
                return f
    return None


def open_path_external(path: Path) -> None:
    """Open a file with the OS image viewer (Windows / WSL / Linux)."""
    import shutil
    import subprocess

    target = str(path)
    try:
        if os.name == "nt":
            os.startfile(target)  # type: ignore[attr-defined]
            return
        if shutil.which("wslview"):
            subprocess.Popen(["wslview", target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
        if shutil.which("xdg-open"):
            subprocess.Popen(["xdg-open", target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
        # WSL without wslview: let Windows Explorer open the UNC path
        subprocess.Popen(
            ["explorer.exe", target],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def render_screenshot(path: Path, max_width: int = 240, max_height_cells: int = 400) -> Text:
    """Render an image as colored half-block unicode (▀), cached.

    Prefer near 1:1 (one image pixel per cell in X, two pixels per cell in Y)
    so text in gowitness shots stays readable. The pane scrolls instead of
    squashing the whole page into a thumbnail.
    """
    try:
        mtime = path.stat().st_mtime
    except Exception:
        mtime = 0
    cache_key = (str(path), int(max_width), int(max_height_cells), mtime)
    cached = _SHOT_RENDER_CACHE.get(cache_key)
    if cached is not None:
        return cached

    try:
        from PIL import Image as PILImage
    except ImportError:
        return Text(
            "Screenshot preview needs Pillow (should auto-install on next launch).\n"
            f"File: {path}"
        )
    try:
        im = PILImage.open(path).convert("RGB")
    except Exception as e:
        return Text(f"Could not open image:\n{path}\n{e}")

    w, h = im.size
    # Never upscale (that only adds blur). Downscale only if the image is huge.
    max_w = max(16, int(max_width))
    max_px_h = max(4, int(max_height_cells) * 2)
    if w > max_w or h > max_px_h:
        scale = min(max_w / w, max_px_h / h, 1.0)
        nw = max(1, int(round(w * scale)))
        nh = max(2, int(round(h * scale)))
        resample = getattr(PILImage, "Resampling", PILImage).BOX
        im = im.resize((nw, nh), resample)
    else:
        nw, nh = w, h
    if nh % 2:
        # Pad one pixel rather than stretching
        canvas = PILImage.new("RGB", (nw, nh + 1), (0, 0, 0))
        canvas.paste(im, (0, 0))
        im = canvas
        nh += 1
    px = im.load()
    out = Text()
    out.append(
        f"{path.name}  {w}×{h}px  →  {nw}×{nh // 2} cells  (scroll · Enter=larger · o=open file)\n",
        style="dim",
    )
    for y in range(0, nh, 2):
        line = Text()
        for x in range(nw):
            r1, g1, b1 = px[x, y]
            r2, g2, b2 = px[x, y + 1] if y + 1 < nh else (0, 0, 0)
            line.append("▀", style=f"rgb({r1},{g1},{b1}) on rgb({r2},{g2},{b2})")
        line.append("\n")
        out.append(line)
    if len(_SHOT_RENDER_CACHE) > 24:
        _SHOT_RENDER_CACHE.clear()
    _SHOT_RENDER_CACHE[cache_key] = out
    return out


class AnnotationManager:
    """Manages annotations for a scan"""

    def __init__(self, scan_path: Path):
        self.scan_path = scan_path
        self.annotation_file = scan_path / ".bbot_ui_annotations.json"
        self.annotations = self.load()

    def _create_empty(self) -> dict:
        """Create empty annotation structure"""
        return {
            "version": "1.0",
            "scan_name": self.scan_path.name,
            "created_at": datetime.utcnow().isoformat() + 'Z',
            "updated_at": datetime.utcnow().isoformat() + 'Z',
            "annotations": {}
        }

    def load(self) -> dict:
        """Load annotations from file"""
        if not self.annotation_file.exists():
            return self._create_empty()

        try:
            with self.annotation_file.open('r') as f:
                return json.load(f)
        except:
            # If file is corrupted, start fresh
            return self._create_empty()

    def save(self) -> bool:
        """Save annotations to file. Returns True on success."""
        self.annotations['updated_at'] = datetime.utcnow().isoformat() + 'Z'
        try:
            with self.annotation_file.open('w') as f:
                json.dump(self.annotations, f, indent=2)
            return True
        except Exception:
            return False

    def get_annotation(self, uuid: str) -> dict:
        """Get annotation for event UUID"""
        return self.annotations['annotations'].get(uuid, {})

    def set_annotation(self, uuid: str, status: str = None,
                      priority: str = None, custom_tags: list = None,
                      note: str = None) -> bool:
        """Set or update annotation. Returns True if saved successfully."""
        if uuid not in self.annotations['annotations']:
            self.annotations['annotations'][uuid] = {
                'created_at': datetime.utcnow().isoformat() + 'Z'
            }

        ann = self.annotations['annotations'][uuid]

        if status is not None:
            ann['status'] = status
        if priority is not None:
            ann['priority'] = priority
        if custom_tags is not None:
            ann['custom_tags'] = custom_tags
        if note is not None:
            ann['note'] = note

        ann['updated_at'] = datetime.utcnow().isoformat() + 'Z'
        return self.save()

    def delete_annotation(self, uuid: str) -> bool:
        """Remove annotation. Returns True if saved successfully."""
        if uuid in self.annotations['annotations']:
            del self.annotations['annotations'][uuid]
            return self.save()
        return True

    def get_stats(self) -> dict:
        """Get annotation statistics"""
        stats = {
            'total': len(self.annotations['annotations']),
            'by_status': {},
            'by_priority': {},
        }

        for ann in self.annotations['annotations'].values():
            status = ann.get('status', 'new')
            stats['by_status'][status] = stats['by_status'].get(status, 0) + 1

            if 'priority' in ann:
                priority = ann['priority']
                stats['by_priority'][priority] = stats['by_priority'].get(priority, 0) + 1

        return stats


class ScanData:
    """Parse and manage BBOT scan data"""

    def __init__(self, scan_path: Path):
        self.scan_path = scan_path
        self.scan_name = scan_path.name
        self.events: List[Dict[str, Any]] = []
        self.scan_info: Dict[str, Any] = {}
        self.preset_content: str = ""
        self.subdomains: List[str] = []
        self.has_subdomains: bool = False
        self.file_position: int = 0  # Track position in output.json for incremental reads
        self.file_handler_cache = None  # Cache for file handler check: (result, timestamp)
        self.cache_ttl = 5.0  # Cache results for 5 seconds
        self.annotation_manager = AnnotationManager(scan_path)  # Annotation system
        self.bbot_version = "unknown"  # BBOT version detection: "2.x", "3.0", or "unknown"
        self._shot_index: Optional[Dict[str, Any]] = None
        self._shot_events: Optional[List[Dict[str, Any]]] = None
        self.load_events()
        self.load_preset()
        self.load_subdomains()

    def load_events(self):
        """Load events from output.json and detect BBOT version"""
        self._shot_index = None
        self._shot_events = None
        json_file = self.scan_path / "output.json"
        if not json_file.exists():
            return

        self.events = []
        self.scan_info = {}
        samples_for_version: List[Dict[str, Any]] = []

        with open(json_file, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        event = json.loads(line)

                        # Collect a few events for version detection
                        if len(samples_for_version) < 20:
                            samples_for_version.append(event)

                        if event.get("type") == "SCAN":
                            # Keep the LAST SCAN event (overwrite previous ones)
                            self.scan_info = event
                        else:
                            self.events.append(event)
                    except json.JSONDecodeError:
                        continue

        self.bbot_version = self._detect_version_from_samples(samples_for_version)

        # Update file position
        try:
            self.file_position = json_file.stat().st_size
        except Exception:
            pass

    def _check_file_open_psutil(self, file_path: Path) -> bool:
        """
        Check if file is open using psutil (native Python, cross-platform).
        Returns True if open, False if not, None if psutil unavailable.
        """
        try:
            import psutil
            file_path_str = str(file_path.resolve())

            # Iterate through all processes
            for proc in psutil.process_iter(['pid', 'name']):
                try:
                    # Check if process has the file open
                    for open_file in proc.open_files():
                        if open_file.path == file_path_str:
                            return True
                except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess):
                    # Process ended or we don't have permission
                    continue

            return False
        except ImportError:
            # psutil not available
            return None
        except Exception:
            # Other error
            return None


    def _has_active_file_handler(self, file_path: Path) -> bool:
        """
        Check if any process has an active file handler on the given file.
        Uses caching to avoid expensive checks on every refresh.
        Returns True if file is open, False if not.
        """
        import time

        # Check cache first
        if self.file_handler_cache is not None:
            cached_result, cached_time = self.file_handler_cache
            if time.time() - cached_time < self.cache_ttl:
                return cached_result

        # Use psutil (auto-installed dependency, cross-platform)
        result = self._check_file_open_psutil(file_path)
        if result is not None:
            self.file_handler_cache = (result, time.time())
            return result

        # psutil failed (should never happen) - assume file is open to be safe
        return True

    def get_scan_status(self) -> str:
        """
        Get the current scan status.
        Returns: "RUNNING", "FINISHED", "INTERRUPTED", or "UNKNOWN"
        """
        scan_data = self._get_scan_data(self.scan_info)
        status = scan_data.get("status", "UNKNOWN")

        # Only check for active processes if status is RUNNING
        # Skip expensive checks for FINISHED scans
        if status == "RUNNING":
            json_file = self.scan_path / "output.json"
            if json_file.exists():
                # Check if process has file open (uses psutil with caching)
                if not self._has_active_file_handler(json_file):
                    # No process has the file open -> scan is interrupted
                    return "INTERRUPTED"

        return status

    def is_scan_running(self) -> bool:
        """Check if the scan is currently running (not interrupted or finished)"""
        return self.get_scan_status() == "RUNNING"

    def check_for_updates(self) -> bool:
        """Check if output.json has new data and scan is still running"""
        status = self.get_scan_status()

        # Don't check for updates if scan is finished or interrupted
        if status in ["FINISHED", "INTERRUPTED"]:
            return False

        json_file = self.scan_path / "output.json"
        if not json_file.exists():
            return False

        try:
            current_size = json_file.stat().st_size

            # Check if file has grown
            if current_size > self.file_position:
                return True
        except:
            pass

        return False

    def load_new_events(self) -> int:
        """Load only new events that have been added since last read. Returns number of new events."""
        json_file = self.scan_path / "output.json"
        if not json_file.exists():
            return 0

        try:
            current_size = json_file.stat().st_size
        except Exception:
            return 0

        # File truncated or replaced (common when scan dir is reused) → full reload
        if current_size < self.file_position:
            self.load_events()
            self.load_preset()
            self.load_subdomains()
            self._shot_index = None
            self._shot_events = None
            # Non-zero so callers refresh UI even if event count is unchanged
            return max(1, len(self.events))

        new_event_count = 0

        try:
            with open(json_file, "r", encoding="utf-8", errors="ignore") as f:
                # Seek to last known position
                f.seek(self.file_position)

                for line in f:
                    line = line.strip()
                    if line:
                        try:
                            event = json.loads(line)
                            if event.get("type") == "SCAN":
                                # Always update scan info to keep the LAST SCAN event
                                self.scan_info = event
                            else:
                                self.events.append(event)
                                new_event_count += 1
                        except json.JSONDecodeError:
                            # Skip malformed lines (might be incomplete writes)
                            continue

            # Update file position
            self.file_position = json_file.stat().st_size

        except Exception:
            # If there's an error reading incrementally, try full reload next time
            pass

        if new_event_count:
            self._shot_index = None
            self._shot_events = None
        return new_event_count

    def load_preset(self):
        """Load preset configuration from preset.yml"""
        preset_file = self.scan_path / "preset.yml"
        if preset_file.exists():
            try:
                with open(preset_file, 'r') as f:
                    self.preset_content = f.read()
            except Exception as e:
                self.preset_content = f"Error loading preset: {e}"
        else:
            self.preset_content = "No preset.yml found in scan directory"

    def load_subdomains(self):
        """Load subdomains from subdomains.txt if present"""
        subdomains_file = self.scan_path / "subdomains.txt"
        if subdomains_file.exists():
            try:
                with open(subdomains_file, 'r') as f:
                    self.subdomains = [line.strip() for line in f if line.strip()]
                self.has_subdomains = len(self.subdomains) > 0
            except Exception as e:
                self.subdomains = []
                self.has_subdomains = False
        else:
            self.subdomains = []
            self.has_subdomains = False

    def _detect_version(self, event: Dict[str, Any]) -> str:
        """Detect BBOT version from a single event."""
        # Strong signal: data_json is BBOT 3.x
        if "data_json" in event:
            return "3.0"

        timestamp = event.get("timestamp")
        if timestamp is None:
            return "unknown"

        if isinstance(timestamp, (int, float)):
            return "3.0"
        if isinstance(timestamp, str) and "T" in timestamp:
            return "2.x"
        return "unknown"

    def _detect_version_from_samples(self, samples: List[Dict[str, Any]]) -> str:
        """Detect BBOT version from multiple events (more reliable than first line)."""
        if not samples:
            return "unknown"
        votes = {"3.0": 0, "2.x": 0}
        for ev in samples:
            v = self._detect_version(ev)
            if v in votes:
                votes[v] += 1
        if votes["3.0"] == 0 and votes["2.x"] == 0:
            return "unknown"
        return "3.0" if votes["3.0"] >= votes["2.x"] else "2.x"

    def _parse_timestamp(self, timestamp):
        """Parse timestamp based on BBOT version"""
        from datetime import datetime

        if self.bbot_version == "3.0":
            # Unix epoch float
            try:
                return datetime.fromtimestamp(timestamp)
            except:
                return datetime.now()
        elif self.bbot_version == "2.x":
            # ISO 8601 string
            try:
                ts_str = str(timestamp).replace("+00:00", "")
                return datetime.fromisoformat(ts_str)
            except:
                return datetime.now()
        else:
            # Fallback: Try both methods
            try:
                if isinstance(timestamp, (int, float)):
                    return datetime.fromtimestamp(timestamp)
                else:
                    ts_str = str(timestamp).replace("+00:00", "")
                    return datetime.fromisoformat(ts_str)
            except:
                return datetime.now()

    def _get_event_data(self, event: Dict[str, Any]) -> Any:
        """Extract event payload (BBOT 2.x ``data`` or 3.x ``data_json``)."""
        return get_event_payload(event)

    def _get_scan_data(self, scan_event: Dict[str, Any]) -> Dict[str, Any]:
        """Extract scan data (alias for _get_event_data)."""
        data = self._get_event_data(scan_event)
        return data if isinstance(data, dict) else {}

    def iter_vulnerability_events(self) -> List[Dict[str, Any]]:
        """Vulns view: 2.x VULNERABILITY + 3.x FINDING with vuln severities."""
        return [e for e in self.events if is_vulnerability_event(e)]

    def iter_finding_events(self) -> List[Dict[str, Any]]:
        """Findings view: informational FINDING events (not vuln-severity)."""
        return [e for e in self.events if is_finding_event(e)]

    def _dns_event_hostname(self, ev: Dict[str, Any]) -> str:
        data = self._get_event_data(ev)
        name = str(
            data if not isinstance(data, dict) else (data.get("host") or data.get("name") or "")
        ).strip().lower().rstrip(".")
        if not name:
            name = str(ev.get("host") or "").strip().lower().rstrip(".")
        return name

    def iter_subdomain_events(self) -> List[Dict[str, Any]]:
        """
        Subdomains view: in-scope DNS_NAME / DNS_NAME_UNRESOLVED only
        (excludes affiliates / scope_distance > 0), plus in-scope names from
        subdomains.txt that lack a matching event.
        """
        by_name: Dict[str, Dict[str, Any]] = {}
        in_scope_roots: set = set()

        for ev in self.events:
            if ev.get("type") not in DNS_NAME_EVENT_TYPES:
                continue
            if not is_in_scope_event(ev):
                continue
            name = self._dns_event_hostname(ev)
            if not name:
                continue

            tags = {str(t).lower() for t in (ev.get("tags") or [])}
            # Apex / seed hosts define which trees belong to the scanned target
            if "domain" in tags or "target" in tags or "seed" in tags:
                in_scope_roots.add(name)
            else:
                # Also treat bare registered domains (two labels) as roots
                if name.count(".") == 1:
                    in_scope_roots.add(name)

            # Prefer resolved DNS_NAME over UNRESOLVED when both exist
            prev = by_name.get(name)
            if prev is None or (
                prev.get("type") == "DNS_NAME_UNRESOLVED" and ev.get("type") == "DNS_NAME"
            ):
                by_name[name] = ev

        # If we never tagged an apex, derive roots from discovered in-scope names
        if not in_scope_roots and by_name:
            for host in by_name:
                parts = host.split(".")
                if len(parts) >= 2:
                    in_scope_roots.add(".".join(parts[-2:]))

        for sub in self.subdomains:
            key = sub.strip().lower().rstrip(".")
            if not key or key in by_name:
                continue
            # Only keep txt entries under the in-scope target tree
            if in_scope_roots and not _host_under_roots(key, in_scope_roots):
                continue
            if not in_scope_roots:
                # No DNS scope signal — trust subdomains.txt (BBOT writes in-scope names)
                pass
            by_name[key] = {
                "type": "DNS_NAME",
                "data": sub.strip(),
                "host": sub.strip(),
                "module": "subdomains.txt",
                "tags": ["from-subdomains-txt", "in-scope"],
                "scope_distance": 0,
                "scope_description": "in-scope",
                "discovery_context": "Listed in subdomains.txt (no matching DNS_NAME event in output.json)",
            }

        return sorted(
            by_name.values(),
            key=lambda e: self._dns_event_hostname(e),
        )

    def iter_screenshot_events(self) -> List[Dict[str, Any]]:
        """WEBSCREENSHOT / gowitness events with resolved image paths (cached)."""
        if self._shot_events is not None:
            return self._shot_events
        if self._shot_index is None:
            self._shot_index = build_screenshot_index(self.scan_path)
        items = []
        for ev in self.events:
            if ev.get("type") not in ("WEBSCREENSHOT", "WEB_SCREENSHOT"):
                continue
            data = self._get_event_data(ev)
            url = ""
            folder = ""
            if isinstance(data, dict):
                url = str(data.get("url") or "")
                folder = str(data.get("path") or "")
            else:
                url = str(data or "")
            if not url:
                url = str(ev.get("url") or "")
            path = find_screenshot_file(
                self.scan_path, url, folder, index=self._shot_index
            )
            rec = dict(ev)
            rec["_screenshot_url"] = url
            rec["_screenshot_path"] = str(path) if path else ""
            items.append(rec)
        items.sort(key=lambda e: e.get("_screenshot_url") or "")
        self._shot_events = items
        return items

    def get_statistics(self) -> Dict[str, Any]:
        """Calculate statistics from events"""
        event_types = {}
        modules = {}
        scope_distances = {}
        severities = {}

        for event in self.events:
            event_type = event.get("type", "UNKNOWN")
            module = event.get("module", "UNKNOWN")
            scope_dist = event.get("scope_distance", 0)

            event_types[event_type] = event_types.get(event_type, 0) + 1
            modules[module] = modules.get(module, 0) + 1
            scope_distances[scope_dist] = scope_distances.get(scope_dist, 0) + 1

            if is_vulnerability_event(event) or is_finding_event(event):
                data = self._get_event_data(event)
                if isinstance(data, dict):
                    sev = normalize_severity(data.get("severity")) or "INFO"
                    severities[sev] = severities.get(sev, 0) + 1

        # Get started_at and format it for display
        started_at_raw = self._get_scan_data(self.scan_info).get("started_at", "Unknown")
        if started_at_raw != "Unknown":
            try:
                started_at = self._parse_timestamp(started_at_raw).strftime("%Y-%m-%d %H:%M:%S")
            except Exception:
                started_at = str(started_at_raw)
        else:
            started_at = "Unknown"

        return {
            "total_events": len(self.events),
            "event_types": event_types,
            "modules": modules,
            "scope_distances": scope_distances,
            "severities": severities,
            "vuln_count": len(self.iter_vulnerability_events()),
            "finding_count": len(self.iter_finding_events()),
            "scan_name": self.scan_name,
            "started_at": started_at,
            "status": self.get_scan_status(),
            "bbot_version": self.bbot_version,
        }

    def build_stats_report(self) -> str:
        """Full text report with unicode bar charts for the Stats detail pane."""
        stats = self.get_statistics()
        ann = self.annotation_manager.get_stats()
        total = stats["total_events"] or 1

        lines = [
            f"Scan: {stats['scan_name']}",
            f"Started: {stats['started_at']}",
            f"Status: {stats['status']}  ·  BBOT schema: {stats['bbot_version']}",
            f"Total events: {stats['total_events']:,}",
            f"Vulns: {stats['vuln_count']:,}  ·  Findings: {stats['finding_count']:,}",
            f"Annotations: {ann['total']:,}",
            "",
        ]

        type_items = sorted(stats["event_types"].items(), key=lambda x: -x[1])
        lines.append(format_bar_chart("Event types", type_items, width=34, limit=20))

        mod_items = sorted(stats["modules"].items(), key=lambda x: -x[1])
        lines.append(format_bar_chart("Top modules", mod_items, width=34, limit=15))

        scope_items = sorted(
            ((str(k), v) for k, v in stats["scope_distances"].items()),
            key=lambda x: int(x[0]) if str(x[0]).lstrip("-").isdigit() else 999,
        )
        lines.append(format_bar_chart("Scope distance", scope_items, width=34, limit=12))

        sev_order = ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO", "UNKNOWN"]
        sev_items = [
            (s, stats["severities"][s])
            for s in sev_order
            if s in stats["severities"]
        ]
        for s, c in sorted(stats["severities"].items(), key=lambda x: -x[1]):
            if s not in sev_order:
                sev_items.append((s, c))
        if sev_items:
            lines.append(format_bar_chart("Issue severity (vulns + findings)", sev_items, width=34, limit=10))

        if ann["by_status"]:
            st_items = sorted(ann["by_status"].items(), key=lambda x: -x[1])
            lines.append(format_bar_chart("Annotation status", st_items, width=34, limit=10))
        if ann.get("by_priority"):
            pr_items = sorted(ann["by_priority"].items(), key=lambda x: -x[1])
            lines.append(format_bar_chart("Annotation priority", pr_items, width=34, limit=8))

        # Compact sparkline of top event-type volumes
        if type_items:
            vals = [float(c) for _, c in type_items[:24]]
            mx = max(vals) or 1.0
            spark_chars = "▁▂▃▄▅▆▇█"
            spark = "".join(
                spark_chars[min(len(spark_chars) - 1, int((v / mx) * (len(spark_chars) - 1)))]
                for v in vals
            )
            lines.append("Event-type sparkline (top types):")
            lines.append(f"  {spark}")
            lines.append("")

        _ = total  # reserved for future % footnotes
        return "\n".join(lines).rstrip() + "\n"

