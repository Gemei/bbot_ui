def normalize_severity(severity: Any) -> str:
    """Canonical severity string (handles 2.x INFORMATIONAL/MODERATE aliases)."""
    if severity is None or severity == "":
        return ""
    s = str(severity).strip().upper()
    return SEVERITY_ALIASES.get(s, s)


def style_severity(severity: str) -> Text:
    """Return a colored severity label for DataTable cells."""
    s = normalize_severity(severity) or "UNKNOWN"
    return Text(s, style=SEVERITY_STYLES.get(s, "dim"))


def get_event_payload(event: Dict[str, Any]) -> Any:
    """
    Version-agnostic event payload.

    BBOT 3.x puts dict-backed events in ``data_json`` (URL, FINDING, SCAN, …)
    and string events in ``data``. BBOT 2.x always used ``data`` (string or dict).
    Prefer ``data_json`` whenever present so mixed/legacy files still work.
    """
    if event.get("data_json") is not None:
        return event["data_json"]
    return event.get("data", {})


def event_url(event: Dict[str, Any], data: Any = None) -> str:
    """Extract URL string from 2.x string data or 3.x data_json dict."""
    if data is None:
        data = get_event_payload(event)
    if isinstance(data, dict):
        return str(data.get("url") or "")
    if event.get("type") in ("URL", "URL_UNVERIFIED", "HTTP_RESPONSE", "STORAGE_BUCKET"):
        return str(data or "")
    return ""


def event_pretty(event: Dict[str, Any], data: Any = None) -> str:
    """Human-readable summary for tables (2.x + 3.x)."""
    if data is None:
        data = get_event_payload(event)
    etype = event.get("type", "")
    if isinstance(data, dict):
        return str(
            data.get("description")
            or data.get("name")
            or data.get("url")
            or data.get("host")
            or data.get("profile_name")
            or data
        )
    return str(data)


def is_vulnerability_event(event: Dict[str, Any]) -> bool:
    """
    True for security issues shown in the Vulns view.

    - BBOT 2.x: type == VULNERABILITY
    - BBOT 3.x: type == FINDING with severity CRITICAL|HIGH|MEDIUM|LOW
    """
    etype = event.get("type", "")
    if etype == "VULNERABILITY":
        return True
    if etype == "FINDING":
        data = get_event_payload(event)
        if isinstance(data, dict):
            sev = normalize_severity(data.get("severity"))
            return sev in VULN_SEVERITIES
    return False


def is_finding_event(event: Dict[str, Any]) -> bool:
    """
    True for informational FINDING events (Findings view).

    - BBOT 2.x: type == FINDING (no severity / not a vuln)
    - BBOT 3.x: type == FINDING with severity INFO (or empty)
    Excludes events already classified as vulnerabilities.
    """
    if event.get("type") != "FINDING":
        return False
    return not is_vulnerability_event(event)


def is_in_scope_event(event: Dict[str, Any]) -> bool:
    """
    True when the event is in scope for the scanned target.

    Prefer explicit tags / scope_distance (BBOT 2.x + 3.x):
    - in-scope tag or scope_distance == 0 → in scope
    - affiliate / distance-* tags or scope_distance > 0 → out of scope
    """
    tags = {str(t).lower() for t in (event.get("tags") or [])}
    if "affiliate" in tags or any(t.startswith("distance-") for t in tags):
        return False
    if "in-scope" in tags:
        return True

    desc = str(event.get("scope_description") or "").lower()
    if desc == "in-scope":
        return True
    if "affiliate" in desc or desc.startswith("distance"):
        return False

    dist = event.get("scope_distance")
    if dist is not None:
        try:
            return int(dist) == 0
        except (TypeError, ValueError):
            pass
    return False


def _host_under_roots(hostname: str, roots: set) -> bool:
    """True if hostname equals or is a subdomain of any root domain."""
    host = hostname.strip().lower().rstrip(".")
    if not host or not roots:
        return False
    if host in roots:
        return True
    return any(host.endswith("." + root) for root in roots)


def classify_issue_counts(event: Dict[str, Any]) -> tuple:
    """Return (vuln_delta, finding_delta) for browser/archive counters."""
    if is_vulnerability_event(event):
        return (1, 0)
    if is_finding_event(event):
        return (0, 1)
    return (0, 0)


