        # watch_mode rebuilds the table once
        self.mode = "scans"

    def action_show_archives(self) -> None:
        self.mode = "archives"
        # Always refresh archive list when switching here (quiet path may skip it)
        if not self._loading:
            self._loading = True
            self.query_one("#browser-status", Static).update("[dim]Loading archives…[/]")
            self._load_data(quiet=True, running_only=False, archives_only=True)

    def action_focus_filter(self) -> None:
        self.query_one("#browser-filter", Input).focus()

