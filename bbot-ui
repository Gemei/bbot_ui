class ScreenshotPreviewScreen(ModalScreen[None]):
    """Full-terminal screenshot preview (Enter from Screenshots view)."""

    BINDINGS = [
        Binding("escape", "close", "Close", show=True),
        Binding("q", "close", "Close", show=False),
        Binding("enter", "close", "Close", show=False),
        Binding("o", "open_file", "Open file", show=True),
    ]

    def __init__(self, image_path: Path, caption: str = ""):
        super().__init__()
        self.image_path = image_path
        self.caption = caption
        self._body = Static("Rendering…", id="shot-full")
        self._img = _make_term_image(str(image_path), id="shot-full-img")

    def compose(self) -> ComposeResult:
        with Vertical(id="shot-full-dialog"):
            yield Static(
                f"{self.image_path.name}   Esc close · o open file",
                classes="pane-title",
            )
            if self._img is not None:
                yield self._img
            else:
                with VerticalScroll(id="shot-full-scroll"):
                    yield self._body

    def on_mount(self) -> None:
        self._size_image()

    def on_resize(self) -> None:
        self._size_image()

    def _size_image(self) -> None:
        if self._img is None:
            self._render()
            return
        max_w = max(24, int(self.size.width) - 4)
        max_h = max(10, int(self.size.height) - 3)
        cw, ch = DetailPane._thumb_cells(self.image_path, max_w=max_w, max_h=max_h)
        self._img.styles.width = cw
        self._img.styles.height = ch

    @work(exclusive=True, thread=True)
    def _render(self) -> None:
        try:
            w = max(40, self.size.width - 4)
            h = max(12, self.size.height - 4)
        except Exception:
            w, h = 80, 24
        text = render_screenshot(self.image_path, max_width=w, max_height_cells=h)
        def _apply() -> None:
            self._body.update(text)
        try:
            self.app.call_from_thread(_apply)
        except Exception:
            pass

    def action_open_file(self) -> None:
        open_path_external(self.image_path)

    def action_close(self) -> None:
        self.dismiss()


