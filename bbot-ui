class SelectableTable(DataTable):
    """DataTable with text selection, zebra rows, markdown export, sort/resize/hide."""

    ALLOW_SELECT = True
    # When False, mouse-move won't highlight rows (sixel previews poison mouse coords).
    track_hover = True
    BINDINGS = [
        Binding("h", "hide_column", "Hide col"),
        Binding("u", "unhide_columns", "Unhide"),
        Binding("minus,left_square_bracket", "shrink_column", "Narrow"),
        Binding("plus,equals,right_square_bracket", "widen_column", "Widen"),
        Binding("shift+left", "shrink_column", "Narrow", show=False),
        Binding("shift+right", "widen_column", "Widen", show=False),
    ]

    class ViewOrderChanged(Message):
        """Posted after sort/hide so parents can sync backing lists."""

        def __init__(self, table: "SelectableTable", reload: bool = False) -> None:
            super().__init__()
            self.table = table
            self.reload = reload

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.cursor_type = "row"
        self.zebra_stripes = True
        self._payloads: Dict[Any, Any] = {}
        self._sort_col = None
        self._sort_reverse = False
        self._hidden_labels: set = set()
        self._widths: Dict[str, int] = {}
        self._last_col_index = 0
        self._declared_columns: List[str] = []
        self._drag_col_index: Optional[int] = None
        self._drag_start_x = 0
        self._drag_start_w = 0
        self.layout_key = kwargs.get("id") or ""
        self.load_layout()

    @staticmethod
    def _cell_text(value: Any) -> str:
        """Normalize a cell value to plain text for clipboard export."""
        if value is None:
            return ""
        if isinstance(value, Text):
            return value.plain
        text = str(value)
        # Collapse whitespace so one logical cell stays on one line
        return " ".join(text.split())

    @staticmethod
    def _md_escape(value: str) -> str:
        """Escape pipe characters for markdown tables."""
        return value.replace("|", "\\|")

    def column_labels(self) -> List[str]:
        labels = []
        for col in self.ordered_columns:
            label = col.label
            labels.append(label.plain if isinstance(label, Text) else str(label))
        return labels

    def row_values(self, row_index: int) -> List[str]:
        """Return plain-text cell values for a visible row index."""
        if row_index < 0 or row_index >= self.row_count:
            return []
        try:
            cells = self.get_row_at(row_index)
        except Exception:
            return []
        return [self._cell_text(c) for c in cells]

    def _normalize_row(self, vals: List[str], headers: List[str]) -> List[str]:
        if not headers:
            return vals
        if len(vals) < len(headers):
            return vals + [""] * (len(headers) - len(vals))
        if len(vals) > len(headers):
            return vals[: len(headers)]
        return vals

    def export_markdown(
        self,
        *,
        row_indices: Optional[List[int]] = None,
    ) -> str:
        """
        Export table data as a GitHub-flavored markdown table.

        Args:
            row_indices: Specific rows to export. None = all rows.
        """
        headers = self.column_labels()
        if row_indices is None:
            indices = list(range(self.row_count))
        else:
            indices = [i for i in row_indices if 0 <= i < self.row_count]

        # If there are no columns yet, nothing to export
        if not headers and self.row_count == 0:
            return ""

        # Infer header count from first data row when labels missing
        if not headers:
            sample = self.row_values(indices[0]) if indices else []
            headers = [f"Col{i+1}" for i in range(len(sample))]

        lines: List[str] = []
        header_cells = [self._md_escape(h) for h in headers]
        lines.append("| " + " | ".join(header_cells) + " |")
        lines.append("| " + " | ".join("---" for _ in headers) + " |")

        for idx in indices:
            vals = self._normalize_row(self.row_values(idx), headers)
            cells = [self._md_escape(v) for v in vals]
            lines.append("| " + " | ".join(cells) + " |")

        return "\n".join(lines) + "\n"

    def export_selected_row_markdown(self) -> str:
        """Export the cursor row as a one-row markdown table."""
        row = self.cursor_row
        if row is None or row < 0 or self.row_count == 0:
            return ""
        return self.export_markdown(row_indices=[row])

    def export_selected_cell(self) -> tuple:
        """Return (column_label, cell_text) for the cursor row + last-used column."""
        row = self.cursor_row
        if row is None or row < 0 or self.row_count == 0:
            return ("", "")
        vals = self.row_values(row)
        labels = [self._col_label(c) for c in self.ordered_columns]
        if not vals or not labels:
            return ("", "")
        idx = min(max(0, self._last_col_index), len(vals) - 1)
        # Skip hidden (width 0) columns in ordered_columns — they're still present
        vis = []
        for i, col in enumerate(self.ordered_columns):
            lab = self._col_label(col)
            if lab in self._hidden_labels or int(col.width or 0) == 0:
                continue
            vis.append(i)
        if vis:
            if idx not in vis:
                # pick nearest visible
                idx = min(vis, key=lambda i: abs(i - idx))
        if idx >= len(vals):
            return ("", "")
        lab = labels[idx] if idx < len(labels) else f"Col{idx+1}"
        return (lab, vals[idx])

    def export_all_markdown(self) -> str:
        """Export the full visible table as markdown."""
        return self.export_markdown(row_indices=None)

    def visible_column_labels(self, labels: List[str]) -> List[str]:
        self._declared_columns = list(labels)
        return [lab for lab in labels if lab not in self._hidden_labels]

    def filter_cells(self, labels: List[str], cells: tuple) -> tuple:
        """Drop cells whose column label is hidden."""
        out = []
        for lab, cell in zip(labels, cells):
            if lab not in self._hidden_labels:
                out.append(cell)
        return tuple(out)

    def add_payload_rows(self, rows_and_payloads: List[tuple]) -> None:
        """Add rows as (cells_tuple, payload). Cells must already be filtered."""
        self._payloads = {}
        if not rows_and_payloads:
            return
        keys = self.add_rows([cells for cells, _ in rows_and_payloads])
        for key, (_cells, payload) in zip(keys, rows_and_payloads):
            self._payloads[key] = payload
        try:
            self._update_dimensions(keys)
            self._require_update_dimensions = False
            if hasattr(self, "_new_rows"):
                self._new_rows.clear()
        except Exception:
            pass
        self._apply_stored_widths()
        self._reapply_sort()
        self._fit_content_widths()

    def load_layout(self) -> None:
        if not self.layout_key:
            return
        widths, hidden = ColumnLayoutStore.get(self.layout_key)
        self._widths = dict(widths)
        self._hidden_labels = set(hidden)

    def save_layout(self) -> None:
        if not self.layout_key:
            return
        # Capture current on-screen widths (skip hidden / zero)
        for col in self.ordered_columns:
            lab = self._col_label(col)
            if lab in self._hidden_labels:
                continue
            w = int(col.width or 0)
            if w > 0:
                self._widths[lab] = w
        ColumnLayoutStore.put(self.layout_key, self._widths, self._hidden_labels)

    def set_layout_key(self, key: str) -> None:
        """Switch persisted layout (saves the previous view first)."""
        if self.layout_key and self.layout_key != key:
            self.save_layout()
        self.layout_key = key
        self.load_layout()

    def payloads_in_view_order(self) -> List[Any]:
        ordered = []
        for row in self.ordered_rows:
            if row.key in self._payloads:
                ordered.append(self._payloads[row.key])
        return ordered

    def _col_label(self, col) -> str:
        lab = col.label.plain if isinstance(col.label, Text) else str(col.label)
        return lab.replace(" ▲", "").replace(" ▼", "")

    def _relayout(self) -> None:
        """Apply column width changes and grow the table's scrollable area."""
        if hasattr(self, "_clear_caches"):
            try:
                self._clear_caches()  # type: ignore[attr-defined]
            except Exception:
                pass
        # DataTable only recomputes virtual_size (needed to WIDEN columns)
        # when this flag is set — otherwise extra width is clipped.
        self._require_update_dimensions = True
        self._update_count = getattr(self, "_update_count", 0) + 1
        try:
            self._update_dimensions([])  # recompute virtual_size now (needed to grow)
            self._require_update_dimensions = False
        except Exception:
            try:
                self.check_idle()
            except Exception:
                pass
        self.refresh(layout=True)
        self._sync_hscroll()

    # (min, max, extra-space weight) — keep short cols tight, let names/URLs grow
    _COL_PRESETS = {
        "Severity": (9, 12, 0),
        "Confidence": (10, 12, 0),
        "Status": (9, 14, 0),
        "Module": (8, 16, 0),
        "Scope": (5, 7, 0),
        "Time": (16, 20, 0),
        "Modified": (16, 20, 0),
        "Events": (6, 8, 0),
        "Vulns": (5, 8, 0),
        "Findings": (8, 10, 0),
        "Count": (6, 10, 0),
        "%": (5, 8, 0),
        "Graph": (16, 24, 0),
        "Resolved": (8, 10, 0),
        "Type": (10, 18, 0),
        "Platform": (10, 16, 0),
        "IP Address": (13, 20, 0),
        "Host": (14, 34, 2),
        "Name": (14, 32, 2),
        "Target": (14, 36, 2),
        "Email": (16, 36, 2),
        "Profile": (12, 24, 1),
        "Tags": (12, 28, 1),
        "File": (12, 28, 1),
        "Subdomain": (16, 40, 3),
        "URL": (20, 50, 3),
        "Data": (16, 44, 3),
        "Metric": (14, 32, 1),
    }

    def _col_preset(self, lab: str) -> tuple:
        return self._COL_PRESETS.get(lab, (8, 36, 1))

    def _fit_content_widths(self) -> None:
        """Size columns to content (capped) and use leftover space on flexible cols."""
        cols = [c for c in self.ordered_columns if self._col_label(c) not in self._hidden_labels]
        if not cols:
            return
        # Saved / user widths: do not redistribute (sort must not change sizes)
        if all(self._col_label(c) in self._widths for c in cols):
            self._apply_stored_widths()
            return
        try:
            avail = max(int(self.size.width) - 1, 40)
        except Exception:
            avail = 80
        pad = int(getattr(self, "cell_padding", 1) or 0)
        chrome = len(cols) * (2 * pad + 1)
        budget = max(len(cols) * 6, avail - chrome)

        ideals = []
        weights = []
        for col in cols:
            lab = self._col_label(col)
            mn, mx, weight = self._col_preset(lab)
            header_w = max(len(lab), mn)
            if lab in self._widths:
                ideal = max(4, int(self._widths[lab]))
                weight = 0
            else:
                content = int(getattr(col, "content_width", 0) or 0)
                ideal = min(max(content, header_w, mn), mx)
            ideals.append(ideal)
            weights.append(weight)

        total = sum(ideals)
        leftover = budget - total
        if leftover > 0 and any(weights):
            wsum = sum(weights) or 1
            for i, w in enumerate(weights):
                if w <= 0:
                    continue
                extra = int(leftover * (w / wsum))
                _mn, mx, _ = self._col_preset(self._col_label(cols[i]))
                ideals[i] = min(ideals[i] + extra, mx + leftover)
        elif leftover < 0:
            # Shrink flexible columns first, then any column down to its min
            order = sorted(range(len(cols)), key=lambda i: weights[i], reverse=True)
            remain = -leftover
            for i in order:
                lab = self._col_label(cols[i])
                mn, _mx, _ = self._col_preset(lab)
                if lab in self._widths:
                    continue
                can = ideals[i] - mn
                if can <= 0:
                    continue
                take = min(can, remain)
                ideals[i] -= take
                remain -= take
                if remain <= 0:
                    break

        for col, width in zip(cols, ideals):
            lab = self._col_label(col)
            if lab in self._hidden_labels:
                continue
            col.auto_width = False
            col.width = max(4, int(width))
            if lab not in self._widths:
                self._widths[lab] = col.width
        self._relayout()
        self.save_layout()

    def _sync_hscroll(self) -> None:
        """Show a horizontal scrollbar only when columns overflow the viewport."""
        try:
            pad = int(getattr(self, "cell_padding", 1) or 0)
            needed = 0
            for col in self.ordered_columns:
                if self._col_label(col) in self._hidden_labels:
                    continue
                needed += int(col.width or 0) + (2 * pad) + 1
            view = int(self.size.width or 0)
            overflow = bool(view) and needed > view + 1
            self.styles.overflow_x = "auto" if overflow else "hidden"
            try:
                self.show_horizontal_scrollbar = overflow
            except Exception:
                pass
        except Exception:
            pass

    def on_resize(self) -> None:
        self._sync_hscroll()

    def _apply_stored_widths(self) -> None:
        for col in self.ordered_columns:
            lab_clean = self._col_label(col)
            if lab_clean in self._hidden_labels:
                col.auto_width = False
                col.width = 0
            elif lab_clean in self._widths:
                col.auto_width = False
                col.width = self._widths[lab_clean]
        self._relayout()

    def _freeze_auto_widths(self) -> None:
        """Lock current computed widths so one resize doesn't get eaten by auto columns."""
        for col in self.ordered_columns:
            lab = self._col_label(col)
            if lab in self._hidden_labels:
                continue
            if col.auto_width or lab not in self._widths:
                w = max(int(col.width or 0), int(getattr(col, "content_width", 0) or 0), 6)
                col.auto_width = False
                col.width = w
                self._widths[lab] = w

    def _set_column_width(self, index: int, width: int, persist: bool = True) -> None:
        cols = list(self.ordered_columns)
        if index < 0 or index >= len(cols):
            return
        col = cols[index]
        lab = self._col_label(col)
        if lab in self._hidden_labels:
            return
        new_w = max(4, min(200, int(width)))
        col.auto_width = False
        col.width = new_w
        self._widths[lab] = new_w
        self._last_col_index = index
        self._relayout()
        if persist:
            self.save_layout()

    def _column_index_for_resize(self) -> int:
        cols = list(self.ordered_columns)
        if not cols:
            return 0
        return min(max(0, self._last_col_index), len(cols) - 1)

    def _header_edges(self) -> List[tuple]:
        """Return (column_index, edge_x) for each visible column's right edge."""
        edges = []
        x = 1  # gutter / row label-ish
        if getattr(self, "show_row_labels", False):
            x += 4
        for i, col in enumerate(self.ordered_columns):
            w = int(col.width or getattr(col, "content_width", 0) or 8)
            if w <= 0:
                continue
            x += w
            edges.append((i, x))
            x += 1  # separator
        return edges

    def _on_mouse_move(self, event) -> None:
        if not self.track_hover:
            return
        try:
            super()._on_mouse_move(event)
        except Exception:
            pass

    def _column_index_at_x(self, x: int) -> Optional[int]:
        acc = 1
        if getattr(self, "show_row_labels", False):
            acc += 4
        for i, col in enumerate(self.ordered_columns):
            w = int(col.width or getattr(col, "content_width", 0) or 8)
            if w <= 0:
                continue
            if acc <= x < acc + w + 1:
                return i
            acc += w + 1
        return None

    def on_mouse_down(self, event) -> None:
        # Drag the header's right edge to resize (y==0 is the header row).
        try:
            y = event.y
            x = event.x
        except Exception:
            return
        col_at = self._column_index_at_x(x)
        if col_at is not None:
            self._last_col_index = col_at
        if y != 0:
            return
        nearest = None
        for idx, edge_x in self._header_edges():
            if abs(x - edge_x) <= 2:
                nearest = (idx, abs(x - edge_x))
                break
        if nearest is None:
            return
        idx = nearest[0]
        cols = list(self.ordered_columns)
        col = cols[idx]
        self._freeze_auto_widths()
        self._drag_col_index = idx
        self._drag_start_x = x
        self._drag_start_w = int(col.width or 8)
        self._last_col_index = idx
        try:
            self.capture_mouse()
        except Exception:
            pass
        event.stop()
        event.prevent_default()

    def on_mouse_move(self, event) -> None:
        if self._drag_col_index is None:
            return
        delta = int(event.x) - self._drag_start_x
        self._set_column_width(
            self._drag_col_index, self._drag_start_w + delta, persist=False
        )
        event.stop()

    def on_mouse_up(self, event) -> None:
        if self._drag_col_index is None:
            return
        self._drag_col_index = None
        try:
            self.release_mouse()
        except Exception:
            pass
        self.save_layout()
        event.stop()

    def _reapply_sort(self) -> None:
        if self._sort_col is None:
            return
        try:
            self.sort(self._sort_col, reverse=self._sort_reverse)
        except Exception:
            pass

    def on_data_table_header_selected(self, event: DataTable.HeaderSelected) -> None:
        self._last_col_index = event.column_index
        col_key = event.column_key
        if self._sort_col == col_key:
            self._sort_reverse = not self._sort_reverse
        else:
            self._sort_col = col_key
            self._sort_reverse = False
        # Keep widths exactly as they are — the sort arrow must not resize columns
        snapped = []
        for col in self.ordered_columns:
            snapped.append((int(col.width or 0), bool(col.auto_width)))
        # Natural-ish sort: numeric strings as numbers
        def _key(val):
            if isinstance(val, tuple):
                val = val[0] if val else ""
            text = self._cell_text(val)
            compact = text.replace(",", "").replace("%", "").strip()
            try:
                return (0, float(compact))
            except ValueError:
                return (1, text.lower())

        try:
            self.sort(col_key, key=_key, reverse=self._sort_reverse)
        except Exception:
            self.sort(col_key, reverse=self._sort_reverse)
        arrow = " ▼" if self._sort_reverse else " ▲"
        try:
            for i, col in enumerate(self.ordered_columns):
                base = self._col_label(col)
                if i == event.column_index:
                    col.label = Text(base + arrow)
                else:
                    col.label = Text(base)
        except Exception:
            pass
        for col, (w, _auto) in zip(self.ordered_columns, snapped):
            if self._col_label(col) in self._hidden_labels:
                col.auto_width = False
                col.width = 0
            elif w > 0:
                col.auto_width = False
                col.width = w
        self._relayout()
        self.post_message(self.ViewOrderChanged(self, reload=False))
        event.stop()

    def action_hide_column(self) -> None:
        cols = list(self.ordered_columns)
        if len(cols) <= 1:
            self.app.notify("Keep at least one column visible", severity="warning", timeout=2)
            return
        idx = min(max(0, self._last_col_index), len(cols) - 1)
        col = cols[idx]
        lab = col.label.plain if isinstance(col.label, Text) else str(col.label)
        lab = lab.replace(" ▲", "").replace(" ▼", "")
        visible = [c for c in cols if (c.width or c.content_width) > 0]
        if len(visible) <= 1:
            self.app.notify("Keep at least one column visible", severity="warning", timeout=2)
            return
        if lab not in self._widths:
            self._widths[lab] = col.width or col.content_width or 12
        col.auto_width = False
        col.width = 0
        self._hidden_labels.add(lab)
        self._relayout()
        self.save_layout()
        self.app.notify(f"Hidden column: {lab}  (press u to restore)", timeout=2)

    def action_unhide_columns(self) -> None:
        for col in self.ordered_columns:
            lab = col.label.plain if isinstance(col.label, Text) else str(col.label)
            lab = lab.replace(" ▲", "").replace(" ▼", "")
            if lab in self._hidden_labels:
                col.width = self._widths.get(lab, max(8, col.content_width or 12))
                col.auto_width = lab not in self._widths
        self._hidden_labels.clear()
        self._relayout()
        self.save_layout()
        self.app.notify("All columns restored", timeout=2)

    def action_shrink_column(self) -> None:
        self._nudge_column(-6)

    def action_widen_column(self) -> None:
        self._nudge_column(6)

    def _nudge_column(self, delta: int) -> None:
        cols = list(self.ordered_columns)
        if not cols:
            return
        self._freeze_auto_widths()
        idx = self._column_index_for_resize()
        col = cols[idx]
        lab = self._col_label(col)
        current = self._widths.get(lab) or col.width or getattr(col, "content_width", 0) or 12
        self._set_column_width(idx, int(current) + delta)
        self.app.notify(f"{lab}: width {self._widths.get(lab, current)}", timeout=1)

    # Back-compat aliases used by older call sites
    def export_selected_row_tsv(self) -> str:
        return self.export_selected_row_markdown()

    def export_all_tsv(self) -> str:
        return self.export_all_markdown()


class DetailPane(Vertical):
    """Right-hand detail pane backed by a read-only TextArea (easy to select/copy)."""

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.plain_text = ""
        self.json_text = ""
        self._title = Static("Details", classes="pane-title")
        self._body = TextArea(
            "Select a row to view details.\n\n"
            "Keys: c copy row · Shift+C / C copy table (markdown) · y JSON",
            id="detail-text",
            read_only=True,
            show_line_numbers=False,
        )
        self._shot_scroll = VerticalScroll(id="shot-scroll")
        self._shot = Static("", id="shot-view", classes="shot-view")
        self._img = _make_term_image(id="shot-img")
        self._shot_path: Optional[Path] = None
        self._shot_caption = ""
        self._shot_token = 0

    def compose(self) -> ComposeResult:
        yield self._title
        yield self._body
        with Vertical(id="shot-box"):
            if self._img is not None:
                yield self._img
            with self._shot_scroll:
                yield self._shot

    def on_mount(self) -> None:
        self._shot_scroll.display = False
        try:
            self.query_one("#shot-box").display = False
        except Exception:
            pass
        if self._img is not None:
            self._img.display = False

    @staticmethod
    def _thumb_cells(path: Path, max_w: int = 36, max_h: int = 12) -> tuple:
        """Contain-fit into max_w x max_h cells (keep aspect, fill the box)."""
        try:
            from PIL import Image as PILImage
            with PILImage.open(path) as im:
                pw, ph = im.size
        except Exception:
            return max(12, max_w // 2), max(6, max_h)
        cell_w, cell_h = 10, 20
        try:
            from textual_image._terminal import get_cell_size
            cs = get_cell_size()
            cell_w = max(1, int(cs.width))
            cell_h = max(1, int(cs.height))
        except Exception:
            pass
        img_cw = max(1.0, pw / cell_w)
        img_ch = max(1.0, ph / cell_h)
        max_w = max(8, int(max_w))
        max_h = max(4, int(max_h))
        scale = min(max_w / img_cw, max_h / img_ch)
        return max(8, int(round(img_cw * scale))), max(4, int(round(img_ch * scale)))

    def _apply_preview_size(self) -> None:
        if self._img is None or not self._shot_path:
            return
        try:
            box = self.query_one("#shot-box")
            max_w = max(24, int(box.size.width) - 2)
            max_h = max(10, int(box.size.height) - 1)
        except Exception:
            max_w, max_h = 56, 24
        cw, ch = self._thumb_cells(self._shot_path, max_w=max_w, max_h=max_h)
        self._img.styles.width = cw
        self._img.styles.height = ch

    def on_resize(self) -> None:
        if self._img is not None and self._img.display:
            self._apply_preview_size()

    def set_empty(self, message: str = "Select a row to view details.") -> None:
        self.plain_text = ""
        self.json_text = ""
        self._title.update("Details")
        self._hide_shot()
        self._body.display = True
        self._body.load_text(
            f"{message}\n\nKeys: c copy row · Shift+C / C copy table (markdown) · y JSON"
        )

    def set_text(self, title: str, plain: str, json_text: str = "") -> None:
        plain = plain or ""
        json_text = json_text or plain or ""
        self._hide_shot()
        self._body.display = True
        # Skip TextArea reload when content unchanged (big win while arrowing rows slowly)
        if plain == self.plain_text and json_text == self.json_text:
            self._title.update(title)
            return
        self.plain_text = plain
        self.json_text = json_text
        self._title.update(title)
        self._body.load_text(self.plain_text if self.plain_text else "(empty)")

    def set_screenshot(self, title: str, caption: str, image_path: Optional[Path]) -> None:
        self.plain_text = caption
        self.json_text = caption
        self._title.update(title)
        self._body.display = False
        self._shot_path = image_path if image_path and image_path.is_file() else None
        self._shot_caption = caption
        if not self._shot_path:
            try:
                self.query_one("#shot-box").display = True
            except Exception:
                pass
            if self._img is not None:
                self._img.display = False
            self._shot_scroll.display = True
            self._shot.update(Text(caption + "\n\n(no image file found on disk)"))
            return
        try:
            self.query_one("#shot-box").display = True
        except Exception:
            pass
        if self._img is not None:
            self._shot_scroll.display = False
            self._img.display = True
            try:
                self._img.image = str(self._shot_path)
                self._apply_preview_size()
            except Exception as e:
                self._img.display = False
                self._shot_scroll.display = True
                self._shot.update(Text(f"Could not display image:\n{e}"))
            return
        self._shot_scroll.display = True
        self._shot.update(Text("Rendering preview…  (o = open file)", style="dim"))
        self._kick_shot_render()

    def _hide_shot(self) -> None:
        self._shot_scroll.display = False
        try:
            self.query_one("#shot-box").display = False
        except Exception:
            pass
        if self._img is not None:
            self._img.display = False
            try:
                self._img.image = None
            except Exception:
                pass

    def _kick_shot_render(self) -> None:
        self._shot_token += 1
        token = self._shot_token
        path = self._shot_path
        if not path:
            return
        try:
            w = max(24, self.size.width - 2)
            h = max(8, self.size.height - 4)
        except Exception:
            w, h = 48, 18
        self._render_shot_worker(str(path), w, h, token)

    @work(exclusive=True, thread=True)
    def _render_shot_worker(self, path_str: str, w: int, h: int, token: int) -> None:
        text = render_screenshot(Path(path_str), max_width=w, max_height_cells=h)
        def _apply() -> None:
            if token != self._shot_token or not self._shot_scroll.display:
                return
            self._shot.update(text)
        try:
            self.app.call_from_thread(_apply)
        except Exception:
            pass

    def set_json(self, title: str, obj: Any) -> None:
        text = json.dumps(obj, indent=2, default=str) if obj else ""
        self.set_text(title, text, text)


