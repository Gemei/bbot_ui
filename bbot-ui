    def __init__(
        self,
        path: Path,
        scan_refresh_interval: float = None,
        list_refresh_interval: float = None,
    ):
        super().__init__()
        self.path = path
        self.is_single_scan = (path / "output.json").exists()
        self.config_file = Path.home() / ".bbot_ui_config.json"
        config = self.load_config()
        self.scan_refresh_interval = (
            scan_refresh_interval
            if scan_refresh_interval is not None
            else config.get("scan_refresh_interval", 2.0)
        )
        self.list_refresh_interval = (
            list_refresh_interval
            if list_refresh_interval is not None
            else config.get("list_refresh_interval", 3.0)
        )
        if scan_refresh_interval is not None or list_refresh_interval is not None:
            config["scan_refresh_interval"] = self.scan_refresh_interval
            config["list_refresh_interval"] = self.list_refresh_interval
            self.save_config(config)

    def load_config(self) -> dict:
        if self.config_file.exists():
            try:
                with open(self.config_file, "r") as f:
                    return json.load(f)
            except Exception:
                return {}
        return {}

    def save_config(self, config: dict) -> None:
        try:
            with open(self.config_file, "w") as f:
                json.dump(config, f, indent=2)
        except Exception:
            pass

    def watch_theme(self, theme: str) -> None:
        config = self.load_config()
        config["theme"] = theme
        self.save_config(config)

    def on_mount(self) -> None:
        config = self.load_config()
        if "theme" in config:
            self.theme = config["theme"]

        if self.is_single_scan:
            self.title = f"BBOT — {self.path.name}"
            # Off-thread load so large output.json does not freeze startup
            self.push_screen(ScanLoadingScreen(self.path, self.scan_refresh_interval))
        else:
            self.title = "BBOT — Scan Browser"
            self.push_screen(BrowserScreen(self.path, self.list_refresh_interval))


def main():
    """Main entry point"""
    import argparse

    parser = argparse.ArgumentParser(
        description="BBOT TUI - Terminal interface for browsing BBOT scan results",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s                                    # Default ~/.bbot/scans
  %(prog)s /path/to/scans                     # Browse scans
  %(prog)s ~/.bbot/scans/example.com          # Open one scan
  %(prog)s --scan-interval 5 --list-interval 10

Keys: ? help · c copy · y JSON · 1/2 scans/archives · q quit
Config: ~/.bbot_ui_config.json
        """,
    )
    parser.add_argument(
        "path",
        nargs="?",
        default=None,
        help="Scan directory or parent scans dir (default: ~/.bbot/scans)",
    )
    parser.add_argument(
        "--scan-interval",
        type=float,
        metavar="SECONDS",
        help="Live refresh interval inside a scan (default: 2.0)",
    )
    parser.add_argument(
        "--list-interval",
        type=float,
        metavar="SECONDS",
        help="Browser refresh interval (default: 3.0)",
    )
    args = parser.parse_args()

    if args.path:
        path = Path(args.path).expanduser()
    else:
        path = Path("~/.bbot/scans").expanduser()
        print(f"No path specified, using default: {path}")

    if not path.exists():
        print(f"Error: Path not found: {path}")
        sys.exit(1)
    if not path.is_dir():
        print(f"Error: Path must be a directory: {path}")
        sys.exit(1)

    has_output_json = (path / "output.json").exists()
    if not has_output_json:
        scan_dirs = [
            d for d in path.iterdir() if d.is_dir() and (d / "output.json").exists()
        ]
        if not scan_dirs:
            print(f"Error: No scan directories found in {path}")
            print("Looking for directories containing output.json files")
            sys.exit(1)

    try:
        import psutil  # noqa: F401
    except ImportError:
        print("\n⚠️  WARNING: psutil is not installed in your virtual environment", file=sys.stderr)
        print("   rm -rf ~/.bbot_ui_venv && ./bbot-ui\n", file=sys.stderr)
        import time
        time.sleep(2)

    app = BBotViewer(
        path,
        scan_refresh_interval=args.scan_interval,
        list_refresh_interval=args.list_interval,
    )
    app.run()


if __name__ == "__main__":
    main()
