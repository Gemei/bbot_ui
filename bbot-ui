    def _switch_view(self, view: str) -> None:
        self.current_view = view
        self._detail_index = -1
        ol = self.query_one("#view-list", OptionList)
        keys = self._view_keys()
        if view in keys:
            try:
                ol.highlighted = keys.index(view)
            except Exception:
                pass

        status_sel = self.query_one("#ws-status-filter", Select)
        type_sel = self.query_one("#ws-type-filter", Select)
        status_sel.display = view in ("vulns", "findings")
        # Events: event-type filter · Social: platform filter
        type_sel.display = view in ("events", "social")
        if view == "events":
            self._refresh_type_filter_options()
        elif view == "social":
            self._refresh_platform_filter_options()

        table = self.query_one("#ws-table", SelectableTable)
        table.set_layout_key(f"ws:{view}")
        table.clear(columns=True)
        table.track_hover = view != "shots"
