            self._timer = self.set_interval(self.refresh_interval, self._poll)

    def _intel_counts(self) -> Dict[str, int]:
        """Count unique intel items for nav labels."""
        self._ensure_type_index()
        by = self._events_by_type or {}
        ips = set()
        for t in IP_EVENT_TYPES:
            for ev in by.get(t, []):
                ips.add(str(self.scan_data._get_event_data(ev)))
        emails = set()
        for t in EMAIL_EVENT_TYPES:
            for ev in by.get(t, []):
                emails.add(str(self.scan_data._get_event_data(ev)).lower())
        social_keys = set()
        for t in SOCIAL_EVENT_TYPES:
            for ev in by.get(t, []):
                data = self.scan_data._get_event_data(ev)
                if isinstance(data, dict):
                    social_keys.add(str(data.get("url") or f"{data.get('platform')}:{data.get('profile_name')}"))
                else:
                    social_keys.add(str(data))
        vulns = len(by.get("VULNERABILITY", []))
        findings = len(by.get("FINDING", []))
        subs = len(self.scan_data.subdomains) if self.scan_data.has_subdomains else 0
        return {
            "vulns": vulns,
            "findings": findings,
            "ips": len(ips),
            "emails": len(emails),
            "social": len(social_keys),
            "subs": subs,
            "events": len(self.scan_data.events),
        }

    def _rebuild_nav(self) -> None:
        """Refresh left nav labels (compact, with counts — no wrap)."""
        ol = self.query_one("#view-list", OptionList)
        c = self._intel_counts()
        try:
            ol.clear_options()
        except Exception:
            while ol.option_count:
                try:
                    ol.remove_option_at_index(0)
                except Exception:
                    break

        # Compact single-line labels so OptionList never wraps mid-entry
        def _cnt(n: int) -> str:
            return f" ({n})" if n else ""

        labels = {
            "vulns": f"1  Vulns{_cnt(c['vulns'])}",
            "findings": f"2  Findings{_cnt(c['findings'])}",
            "ips": f"3  IPs{_cnt(c['ips'])}",
            "emails": f"4  Emails{_cnt(c['emails'])}",
            "social": f"5  Social{_cnt(c['social'])}",
            "subs": f"6  Subdomains{_cnt(c['subs'])}",
            "events": f"7  Events{_cnt(c['events'])}",
            "stats": "8  Stats",
            "config": "9  Preset",
        }
        # Always show all views (empty Subdomains is fine)
        for key, _ in VIEWS:
            ol.add_option(Option(labels.get(key, key), id=key))
        keys = self._view_keys()
        if self.current_view in keys:
