def format_event_plain(event: Dict[str, Any], scan_data: Optional["ScanData"] = None) -> str:
    """Human-readable plain text for an event (good for clipboard)."""
    if not event:
        return ""
    event_type = event.get("type", "UNKNOWN")
    if scan_data:
        data = scan_data._get_event_data(event)
    else:
        data = event.get("data_json") or event.get("data", {})

    lines = [event_type, ""]
    if event_type == "VULNERABILITY" and isinstance(data, dict):
        lines.append(f"Severity: {data.get('severity', 'UNKNOWN')}")
        lines.append("")
    if isinstance(data, dict):
        host = data.get("host", event.get("host", "N/A"))
        lines.append(f"Host: {host}")
        if data.get("url"):
            lines.append(f"URL: {data.get('url')}")
        lines.append("")
        if data.get("description"):
            lines.append("Description:")
            lines.append(str(data.get("description")))
            lines.append("")
        # Remaining key fields
        for key in ("name", "severity", "path", "title"):
            if key in data and key not in ("severity",) and data[key] not in (None, ""):
                if key == "name":
                    lines.append(f"Name: {data[key]}")
    else:
        lines.append(f"Data: {data}")
        lines.append("")

    lines.append(f"Module: {event.get('module', 'N/A')}")
    if event.get("module_sequence"):
        lines.append(f"Module Sequence: {event.get('module_sequence')}")
    if event.get("discovery_context"):
        lines.append("")
        lines.append("Discovery Context:")
        lines.append(str(event.get("discovery_context")))
    discovery_path = event.get("discovery_path") or []
    if discovery_path:
        lines.append("")
        lines.append("Discovery Path:")
        for i, step in enumerate(discovery_path, 1):
            lines.append(f"{i}. {step}")
    tags = event.get("tags") or []
    if tags:
        lines.append("")
        lines.append(f"Tags: {', '.join(str(t) for t in tags)}")
    if event.get("timestamp") is not None:
        lines.append("")
        lines.append(f"Timestamp: {event.get('timestamp')}")
    resolved = event.get("resolved_hosts") or []
    if resolved:
        lines.append(f"Resolved IPs: {', '.join(str(h) for h in resolved)}")
    if event.get("port") is not None:
        lines.append(f"Port: {event.get('port')}")
    return "\n".join(lines).rstrip() + "\n"


def notify_copied(screen: Screen, label: str, text: str) -> None:
    """Copy text to clipboard and show a short toast."""
    if text is None or text == "":
        screen.notify("Nothing to copy", severity="warning", timeout=2)
        return
    screen.app.copy_to_clipboard(text)
    preview = " ".join(str(text).split())
    if len(preview) > 72:
        preview = preview[:72] + "…"
    screen.notify(f"Copied {label}: {preview}", title="Clipboard", timeout=2)


class AnnotationManager:
    """Manages annotations for a scan"""

    def __init__(self, scan_path: Path):
        self.scan_path = scan_path
        self.annotation_file = scan_path / ".bbot_ui_annotations.json"
        self.annotations = self.load()

    def _create_empty(self) -> dict:
        """Create empty annotation structure"""
        return {
            "version": "1.0",
            "scan_name": self.scan_path.name,
            "created_at": datetime.utcnow().isoformat() + 'Z',
            "updated_at": datetime.utcnow().isoformat() + 'Z',
            "annotations": {}
        }

    def load(self) -> dict:
        """Load annotations from file"""
        if not self.annotation_file.exists():
            return self._create_empty()

        try:
            with self.annotation_file.open('r') as f:
                return json.load(f)
        except:
            # If file is corrupted, start fresh
            return self._create_empty()

    def save(self) -> bool:
        """Save annotations to file. Returns True on success."""
        self.annotations['updated_at'] = datetime.utcnow().isoformat() + 'Z'
        try:
            with self.annotation_file.open('w') as f:
                json.dump(self.annotations, f, indent=2)
            return True
        except Exception:
            return False

    def get_annotation(self, uuid: str) -> dict:
        """Get annotation for event UUID"""
        return self.annotations['annotations'].get(uuid, {})

    def set_annotation(self, uuid: str, status: str = None,
                      priority: str = None, custom_tags: list = None,
                      note: str = None) -> bool:
        """Set or update annotation. Returns True if saved successfully."""
        if uuid not in self.annotations['annotations']:
            self.annotations['annotations'][uuid] = {
                'created_at': datetime.utcnow().isoformat() + 'Z'
            }

        ann = self.annotations['annotations'][uuid]

        if status is not None:
            ann['status'] = status
        if priority is not None:
            ann['priority'] = priority
        if custom_tags is not None:
            ann['custom_tags'] = custom_tags
        if note is not None:
            ann['note'] = note

        ann['updated_at'] = datetime.utcnow().isoformat() + 'Z'
        return self.save()

    def delete_annotation(self, uuid: str) -> bool:
        """Remove annotation. Returns True if saved successfully."""
        if uuid in self.annotations['annotations']:
            del self.annotations['annotations'][uuid]
            return self.save()
        return True

    def get_stats(self) -> dict:
        """Get annotation statistics"""
        stats = {
            'total': len(self.annotations['annotations']),
            'by_status': {},
            'by_priority': {},
        }

        for ann in self.annotations['annotations'].values():
            status = ann.get('status', 'new')
            stats['by_status'][status] = stats['by_status'].get(status, 0) + 1

            if 'priority' in ann:
                priority = ann['priority']
                stats['by_priority'][priority] = stats['by_priority'].get(priority, 0) + 1

        return stats


class ScanData:
    """Parse and manage BBOT scan data"""

    def __init__(self, scan_path: Path):
        self.scan_path = scan_path
        self.scan_name = scan_path.name
        self.events: List[Dict[str, Any]] = []
        self.scan_info: Dict[str, Any] = {}
        self.preset_content: str = ""
        self.subdomains: List[str] = []
        self.has_subdomains: bool = False
        self.file_position: int = 0  # Track position in output.json for incremental reads
        self.file_handler_cache = None  # Cache for file handler check: (result, timestamp)
        self.cache_ttl = 5.0  # Cache results for 5 seconds
        self.annotation_manager = AnnotationManager(scan_path)  # Annotation system
        self.bbot_version = "unknown"  # BBOT version detection: "2.x", "3.0", or "unknown"
        self.load_events()
        self.load_preset()
        self.load_subdomains()

    def load_events(self):
        """Load events from output.json and detect BBOT version"""
        json_file = self.scan_path / "output.json"
        if not json_file.exists():
            return

        self.events = []
        self.scan_info = {}
        samples_for_version: List[Dict[str, Any]] = []

        with open(json_file, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        event = json.loads(line)

                        # Collect a few events for version detection
                        if len(samples_for_version) < 20:
                            samples_for_version.append(event)

                        if event.get("type") == "SCAN":
                            # Keep the LAST SCAN event (overwrite previous ones)
                            self.scan_info = event
                        else:
                            self.events.append(event)
                    except json.JSONDecodeError:
                        continue

        self.bbot_version = self._detect_version_from_samples(samples_for_version)

        # Update file position
        try:
            self.file_position = json_file.stat().st_size
        except Exception:
            pass

    def _check_file_open_psutil(self, file_path: Path) -> bool:
        """
        Check if file is open using psutil (native Python, cross-platform).
        Returns True if open, False if not, None if psutil unavailable.
        """
        try:
            import psutil
            file_path_str = str(file_path.resolve())

            # Iterate through all processes
            for proc in psutil.process_iter(['pid', 'name']):
                try:
                    # Check if process has the file open
                    for open_file in proc.open_files():
                        if open_file.path == file_path_str:
                            return True
                except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess):
                    # Process ended or we don't have permission
                    continue

            return False
        except ImportError:
            # psutil not available
            return None
        except Exception:
            # Other error
            return None


    def _has_active_file_handler(self, file_path: Path) -> bool:
        """
        Check if any process has an active file handler on the given file.
        Uses caching to avoid expensive checks on every refresh.
        Returns True if file is open, False if not.
        """
        import time

        # Check cache first
        if self.file_handler_cache is not None:
            cached_result, cached_time = self.file_handler_cache
            if time.time() - cached_time < self.cache_ttl:
                return cached_result

        # Use psutil (auto-installed dependency, cross-platform)
        result = self._check_file_open_psutil(file_path)
        if result is not None:
            self.file_handler_cache = (result, time.time())
            return result

        # psutil failed (should never happen) - assume file is open to be safe
        return True

    def get_scan_status(self) -> str:
        """
        Get the current scan status.
        Returns: "RUNNING", "FINISHED", "INTERRUPTED", or "UNKNOWN"
        """
        scan_data = self._get_scan_data(self.scan_info)
        status = scan_data.get("status", "UNKNOWN")

        # Only check for active processes if status is RUNNING
        # Skip expensive checks for FINISHED scans
        if status == "RUNNING":
            json_file = self.scan_path / "output.json"
            if json_file.exists():
                # Check if process has file open (uses psutil with caching)
                if not self._has_active_file_handler(json_file):
                    # No process has the file open -> scan is interrupted
                    return "INTERRUPTED"

        return status

    def is_scan_running(self) -> bool:
        """Check if the scan is currently running (not interrupted or finished)"""
        return self.get_scan_status() == "RUNNING"

    def check_for_updates(self) -> bool:
        """Check if output.json has new data and scan is still running"""
        status = self.get_scan_status()

        # Don't check for updates if scan is finished or interrupted
        if status in ["FINISHED", "INTERRUPTED"]:
            return False

        json_file = self.scan_path / "output.json"
        if not json_file.exists():
            return False

        try:
            current_size = json_file.stat().st_size

            # Check if file has grown
            if current_size > self.file_position:
                return True
        except:
            pass

        return False

    def load_new_events(self) -> int:
        """Load only new events that have been added since last read. Returns number of new events."""
        json_file = self.scan_path / "output.json"
        if not json_file.exists():
            return 0

        try:
            current_size = json_file.stat().st_size
        except Exception:
            return 0

        # File truncated or replaced (common when scan dir is reused) → full reload
        if current_size < self.file_position:
            self.load_events()
            self.load_preset()
            self.load_subdomains()
            # Non-zero so callers refresh UI even if event count is unchanged
            return max(1, len(self.events))

        new_event_count = 0

        try:
            with open(json_file, "r", encoding="utf-8", errors="ignore") as f:
                # Seek to last known position
                f.seek(self.file_position)

                for line in f:
                    line = line.strip()
                    if line:
                        try:
                            event = json.loads(line)
                            if event.get("type") == "SCAN":
                                # Always update scan info to keep the LAST SCAN event
                                self.scan_info = event
                            else:
                                self.events.append(event)
                                new_event_count += 1
                        except json.JSONDecodeError:
                            # Skip malformed lines (might be incomplete writes)
                            continue

            # Update file position
            self.file_position = json_file.stat().st_size

        except Exception:
            # If there's an error reading incrementally, try full reload next time
            pass

        return new_event_count

    def load_preset(self):
        """Load preset configuration from preset.yml"""
        preset_file = self.scan_path / "preset.yml"
        if preset_file.exists():
            try:
                with open(preset_file, 'r') as f:
                    self.preset_content = f.read()
            except Exception as e:
                self.preset_content = f"Error loading preset: {e}"
        else:
            self.preset_content = "No preset.yml found in scan directory"

    def load_subdomains(self):
        """Load subdomains from subdomains.txt if present"""
        subdomains_file = self.scan_path / "subdomains.txt"
        if subdomains_file.exists():
            try:
                with open(subdomains_file, 'r') as f:
                    self.subdomains = [line.strip() for line in f if line.strip()]
                self.has_subdomains = len(self.subdomains) > 0
            except Exception as e:
                self.subdomains = []
                self.has_subdomains = False
        else:
            self.subdomains = []
            self.has_subdomains = False

    def _detect_version(self, event: Dict[str, Any]) -> str:
        """Detect BBOT version from a single event."""
        # Strong signal: data_json is BBOT 3.x
        if "data_json" in event:
            return "3.0"

        timestamp = event.get("timestamp")
        if timestamp is None:
            return "unknown"

        if isinstance(timestamp, (int, float)):
            return "3.0"
        if isinstance(timestamp, str) and "T" in timestamp:
            return "2.x"
        return "unknown"

    def _detect_version_from_samples(self, samples: List[Dict[str, Any]]) -> str:
        """Detect BBOT version from multiple events (more reliable than first line)."""
        if not samples:
            return "unknown"
        votes = {"3.0": 0, "2.x": 0}
        for ev in samples:
            v = self._detect_version(ev)
            if v in votes:
                votes[v] += 1
        if votes["3.0"] == 0 and votes["2.x"] == 0:
            return "unknown"
        return "3.0" if votes["3.0"] >= votes["2.x"] else "2.x"

    def _parse_timestamp(self, timestamp):
        """Parse timestamp based on BBOT version"""
        from datetime import datetime

        if self.bbot_version == "3.0":
            # Unix epoch float
            try:
                return datetime.fromtimestamp(timestamp)
            except:
                return datetime.now()
        elif self.bbot_version == "2.x":
            # ISO 8601 string
            try:
                ts_str = str(timestamp).replace("+00:00", "")
                return datetime.fromisoformat(ts_str)
            except:
                return datetime.now()
        else:
            # Fallback: Try both methods
            try:
                if isinstance(timestamp, (int, float)):
                    return datetime.fromtimestamp(timestamp)
                else:
                    ts_str = str(timestamp).replace("+00:00", "")
                    return datetime.fromisoformat(ts_str)
            except:
                return datetime.now()

    def _get_event_data(self, event: Dict[str, Any]) -> Any:
        """Extract event data based on BBOT version (works for all event types)

        Returns the data value which can be:
        - A dict (for complex events like VULNERABILITY, FINDING, SCAN)
        - A string or other simple value (for simple events like DNS_NAME, URL, OPEN_TCP_PORT)
        """
        if self.bbot_version == "3.0":
            # BBOT 3.0: Try data_json first (for VULNERABILITY, FINDING, SCAN)
            # Fall back to data (for simple events like DNS_NAME, URL, OPEN_TCP_PORT)
            if "data_json" in event:
                return event.get("data_json", {})
            else:
                return event.get("data", {})
        else:
            # BBOT 2.x: Always use data
            return event.get("data", {})

    def _get_scan_data(self, scan_event: Dict[str, Any]) -> Dict[str, Any]:
        """Extract scan data based on BBOT version (alias for _get_event_data for backward compatibility)"""
        return self._get_event_data(scan_event)

    def get_statistics(self) -> Dict[str, Any]:
        """Calculate statistics from events"""
        event_types = {}
        modules = {}
        scope_distances = {}

        for event in self.events:
            event_type = event.get("type", "UNKNOWN")
            module = event.get("module", "UNKNOWN")
            scope_dist = event.get("scope_distance", 0)

            event_types[event_type] = event_types.get(event_type, 0) + 1
            modules[module] = modules.get(module, 0) + 1
            scope_distances[scope_dist] = scope_distances.get(scope_dist, 0) + 1

        # Get started_at and format it for display
        started_at_raw = self._get_scan_data(self.scan_info).get("started_at", "Unknown")
        if started_at_raw != "Unknown":
            try:
                started_at = self._parse_timestamp(started_at_raw).strftime("%Y-%m-%d %H:%M:%S")
            except:
                started_at = str(started_at_raw)
        else:
            started_at = "Unknown"

        return {
            "total_events": len(self.events),
            "event_types": event_types,
            "modules": modules,
            "scope_distances": scope_distances,
            "scan_name": self.scan_name,
            "started_at": started_at,
        }

