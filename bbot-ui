_UI_STATE_DIR = Path("~/.bbot_ui").expanduser()
_COLUMN_LAYOUT_FILE = _UI_STATE_DIR / "column_layout.json"


class ColumnLayoutStore:
    """Load/save table column widths and hidden columns across sessions."""

    _cache: Optional[dict] = None

    @classmethod
    def load_all(cls) -> dict:
        if cls._cache is not None:
            return cls._cache
        try:
            if _COLUMN_LAYOUT_FILE.is_file():
                cls._cache = json.loads(_COLUMN_LAYOUT_FILE.read_text(encoding="utf-8"))
            else:
                cls._cache = {}
        except Exception:
            cls._cache = {}
        if not isinstance(cls._cache, dict):
            cls._cache = {}
        return cls._cache

    @classmethod
    def get(cls, key: str) -> tuple:
        data = cls.load_all().get(key) or {}
        widths = {}
        for k, v in (data.get("widths") or {}).items():
            try:
                widths[str(k)] = max(4, int(v))
            except (TypeError, ValueError):
                continue
        hidden = [str(x) for x in (data.get("hidden") or [])]
        return widths, hidden

    @classmethod
    def put(cls, key: str, widths: dict, hidden) -> None:
        if not key:
            return
        all_data = cls.load_all()
        all_data[key] = {
            "widths": {str(k): int(v) for k, v in widths.items() if int(v) > 0},
            "hidden": list(hidden),
        }
        cls._cache = all_data
        try:
            _UI_STATE_DIR.mkdir(parents=True, exist_ok=True)
            _COLUMN_LAYOUT_FILE.write_text(
                json.dumps(all_data, indent=2, sort_keys=True) + "\n",
                encoding="utf-8",
            )
        except Exception:
            pass


