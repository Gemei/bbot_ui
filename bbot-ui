        table.layout_key = "browser"
        table.load_layout()
        table.add_columns(*table.visible_column_labels(
            ["Name", "Target", "Status", "Events", "Vulns", "Findings", "Modified"]
        ))
        self._set_title()
        self.action_refresh()
        self._timer = self.set_interval(self.refresh_interval, self._auto_refresh)

