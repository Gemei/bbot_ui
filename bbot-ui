        try:
            detail.styles.width = "42%"
        except Exception:
            pass

        if view == "vulns":
            table.add_columns("Severity", "Host", "Name", "Confidence", "Status", "Module")
        elif view == "findings":
            table.add_columns("Severity", "Host", "Name", "Confidence", "Status", "Module")
        elif view == "ips":
            table.add_columns("IP Address", "Module", "Scope", "Tags")
        elif view == "emails":
            table.add_columns("Email", "Module", "Scope", "Tags")
        elif view == "social":
            table.add_columns("Platform", "Profile", "URL", "Module")
        elif view == "events":
            table.add_columns("Type", "Data", "Module", "Scope", "Time")
        elif view == "stats":
            table.add_columns("Metric", "Count", "%", "Graph")
        elif view == "subs":
            table.add_columns("Subdomain", "Module", "Scope", "Tags", "Resolved")
        elif view == "shots":
            table.add_columns("URL", "File", "Module", "Scope")
        elif view == "config":
            table.add_columns("File")
            detail.set_text(
                "preset.yml",
                self.scan_data.preset_content or "",
                self.scan_data.preset_content or "",
            )
            table.add_row("preset.yml")
            self.item_list = ["preset"]
            return

        self._reload_items()

    def _matches_status(self, event: dict) -> bool:
        if self.current_view not in ("vulns", "findings"):
            return True
        uuid = event.get("uuid", "")
        ann = self.scan_data.annotation_manager.get_annotation(uuid)
        st = ann.get("status", "new")
        if self.status_filter == "All":
            return True
        if self.status_filter == "Actionable":
            return st in ACTIONABLE_STATUSES
        return st == self.status_filter

    def _matches_type(self, event: dict) -> bool:
        if self.current_view == "social":
            pf = self.platform_filter
            if pf in (None, "All", Select.BLANK, False):
                return True
            data = self.scan_data._get_event_data(event)
            if isinstance(data, dict):
                return str(data.get("platform", "")) == str(pf)
            return False
        tf = self.event_type_filter
        if tf in (None, "All", Select.BLANK, False):
            return True
        return (event.get("type") or "UNKNOWN") == tf

    def _matches_search(self, text: str) -> bool:
        if not self._search_terms:
            return True
        low = text.lower()
        return all(term in low for term in self._search_terms)

    def _sync_search_terms(self) -> None:
        q = self.filter_query.strip().lower()
        self._search_terms = q.split() if q else []

    def _event_summary(self, ev: dict, data: Any) -> str:
        return event_pretty(ev, data)[:80]

    def _format_ts(self, ts: Any) -> str:
        if not ts:
            return ""
        try:
            if isinstance(ts, str) and "T" in ts:
                return datetime.fromisoformat(ts.replace("Z", "+00:00")).strftime("%H:%M:%S")
            if isinstance(ts, (int, float)):
                return datetime.fromtimestamp(ts).strftime("%H:%M:%S")
        except Exception:
            pass
        return str(ts)[:10]

    def _iter_typed_events(self, include_scan: bool = False):
        """Return events optionally filtered by type dropdown (preserves scan order)."""
        self._ensure_type_index()
        assert self._events_by_type is not None
        tf = self.event_type_filter
        if tf not in (None, "All", Select.BLANK, False):
            return list(self._events_by_type.get(str(tf), []))
        # Preserve original discovery order
        if include_scan:
            return self.scan_data.events
        return [e for e in self.scan_data.events if e.get("type") != "SCAN"]

    def _reload_items(self) -> None:
        view = self.current_view
        table = self.query_one("#ws-table", SelectableTable)
        detail = self.query_one("#ws-detail", DetailPane)
        old = table.cursor_row
        table.clear()
        self.item_list = []
        self._detail_index = -1
        self._sync_search_terms()
        rows: List[tuple] = []
        get_data = self.scan_data._get_event_data
        ann_get = self.scan_data.annotation_manager.get_annotation
        max_rows = self.MAX_ROWS

        if view == "vulns":
            items = self.scan_data.iter_vulnerability_events()

            def _sev_key(v: dict) -> int:
                d = get_data(v)
                if not isinstance(d, dict):
                    return 0
                return self.SEVERITY_RANK.get(normalize_severity(d.get("severity")), 0)

            items.sort(key=_sev_key, reverse=True)
            for ev in items:
                if not self._matches_status(ev):
                    continue
                data = get_data(ev)
                if not isinstance(data, dict):
                    data = {}
                host = str(data.get("host") or ev.get("host") or "")
                name = str(data.get("name") or "")
                desc = str(data.get("description") or "")
                conf = str(data.get("confidence") or "")
                module = str(ev.get("module", "") or "")
                if not self._matches_search(f"{host} {name} {desc} {module} {conf}"):
                    continue
                st = ann_get(ev.get("uuid", "")).get("status", "new")
                self.item_list.append(ev)
                rows.append((
                    style_severity(data.get("severity", "UNKNOWN")),
                    Text(host, no_wrap=True, overflow="ellipsis"),
                    Text((name or desc)[:100], no_wrap=True, overflow="ellipsis"),
                    Text(conf, no_wrap=True, overflow="ellipsis"),
                    style_annotation_label(st, STATUS_OPTIONS.get(st, STATUS_OPTIONS["new"])["label"]),
                    Text(module, no_wrap=True, overflow="ellipsis"),
                ))
                if len(rows) >= max_rows:
                    break

        elif view == "findings":
            for ev in self.scan_data.iter_finding_events():
                if not self._matches_status(ev):
                    continue
                data = get_data(ev)
                if not isinstance(data, dict):
                    data = {}
                host = str(data.get("host") or ev.get("host") or "")
                name = str(data.get("name") or "")
                desc = str(data.get("description") or "")
                conf = str(data.get("confidence") or "")
                sev = normalize_severity(data.get("severity")) or "INFO"
                module = str(ev.get("module", "") or "")
                if not self._matches_search(f"{host} {name} {desc} {module} {sev}"):
                    continue
                st = ann_get(ev.get("uuid", "")).get("status", "new")
                self.item_list.append(ev)
                rows.append((
                    style_severity(sev),
                    Text(host, no_wrap=True, overflow="ellipsis"),
                    Text((name or desc)[:100], no_wrap=True, overflow="ellipsis"),
                    Text(conf, no_wrap=True, overflow="ellipsis"),
                    style_annotation_label(st, STATUS_OPTIONS.get(st, STATUS_OPTIONS["new"])["label"]),
                    Text(module, no_wrap=True, overflow="ellipsis"),
                ))
                if len(rows) >= max_rows:
                    break

        elif view == "ips":
            items = self._dedupe_events(
                self._events_of_types(IP_EVENT_TYPES),
                key_fn=lambda e: str(get_data(e)),
            )
            items.sort(key=lambda e: str(get_data(e)))
            for ev in items:
                data = get_data(ev)
                ip = str(data) if not isinstance(data, dict) else str(
                    data.get("ip") or data.get("host") or data
                )
                module = str(ev.get("module", "") or "")
                tags = ", ".join(str(t) for t in (ev.get("tags") or [])[:6])
                if not self._matches_search(f"{ip} {module} {tags}"):
                    continue
                self.item_list.append(ev)
                rows.append((
                    Text(ip, no_wrap=True, overflow="ellipsis"),
                    Text(module, no_wrap=True, overflow="ellipsis"),
                    str(ev.get("scope_distance", "")),
                    Text(tags, no_wrap=True, overflow="ellipsis"),
                ))
                if len(rows) >= max_rows:
                    break

        elif view == "emails":
            items = self._dedupe_events(
                self._events_of_types(EMAIL_EVENT_TYPES),
                key_fn=lambda e: str(get_data(e)).lower(),
            )
            items.sort(key=lambda e: str(get_data(e)).lower())
            for ev in items:
                data = get_data(ev)
                email = str(data) if not isinstance(data, dict) else str(
                    data.get("email") or data.get("address") or data
                )
                module = str(ev.get("module", "") or "")
                tags = ", ".join(str(t) for t in (ev.get("tags") or [])[:6])
                if not self._matches_search(f"{email} {module} {tags}"):
                    continue
                self.item_list.append(ev)
                rows.append((
                    Text(email, no_wrap=True, overflow="ellipsis"),
                    Text(module, no_wrap=True, overflow="ellipsis"),
                    str(ev.get("scope_distance", "")),
                    Text(tags, no_wrap=True, overflow="ellipsis"),
                ))
                if len(rows) >= max_rows:
                    break

        elif view == "social":
            items = self._events_of_types(SOCIAL_EVENT_TYPES)
            # Prefer unique by url or platform+profile
            def _social_key(e: dict) -> str:
                d = get_data(e)
                if isinstance(d, dict):
                    return str(d.get("url") or f"{d.get('platform','')}:{d.get('profile_name','')}")
                return str(d)

            items = self._dedupe_events(items, key_fn=_social_key)

            def _social_sort(e: dict) -> tuple:
                d = get_data(e)
                if isinstance(d, dict):
                    return (str(d.get("platform", "")), str(d.get("profile_name", "")))
                return ("", str(d))

            items.sort(key=_social_sort)
            for ev in items:
                if not self._matches_type(ev):
                    continue
                data = get_data(ev)
                if not isinstance(data, dict):
                    data = {"url": str(data)}
                platform = str(data.get("platform", "") or "")
                profile = str(data.get("profile_name", "") or "")
                url = str(data.get("url", "") or "")
                module = str(ev.get("module", "") or "")
                if not self._matches_search(f"{platform} {profile} {url} {module}"):
                    continue
                self.item_list.append(ev)
                rows.append((
                    Text(platform, no_wrap=True, overflow="ellipsis"),
                    Text(profile, no_wrap=True, overflow="ellipsis"),
                    Text(url, no_wrap=True, overflow="ellipsis"),
                    Text(module, no_wrap=True, overflow="ellipsis"),
                ))
                if len(rows) >= max_rows:
                    break

        elif view == "shots":
            for ev in self.scan_data.iter_screenshot_events():
                url = str(ev.get("_screenshot_url") or "")
                fpath = str(ev.get("_screenshot_path") or "")
                fname = Path(fpath).name if fpath else "(missing)"
                module = str(ev.get("module") or "gowitness")
                blob = f"{url} {fname} {module}"
                if not self._matches_search(blob):
                    continue
                self.item_list.append(ev)
                rows.append((
                    Text(url, no_wrap=True, overflow="ellipsis"),
                    Text(fname, no_wrap=True, overflow="ellipsis"),
                    Text(module, no_wrap=True, overflow="ellipsis"),
                    str(ev.get("scope_distance", "")),
                ))
                if len(rows) >= max_rows:
                    break

        elif view == "events":
            for ev in self._iter_typed_events(include_scan=True):
                if not self._matches_type(ev):
                    continue
                data = get_data(ev)
                summary = self._event_summary(ev, data)
                etype = str(ev.get("type", "") or "")
                module = str(ev.get("module", "") or "")
                if not self._matches_search(f"{etype} {summary} {module}"):
                    continue
                self.item_list.append(ev)
                rows.append((
                    Text(etype, no_wrap=True),
                    Text(summary, no_wrap=True, overflow="ellipsis"),
                    Text(module, no_wrap=True, overflow="ellipsis"),
                    str(ev.get("scope_distance", "")),
                    self._format_ts(ev.get("timestamp", "")),
                ))
                if len(rows) >= max_rows:
                    break

        elif view == "stats":
            stats = self.scan_data.get_statistics()
            ann = self.scan_data.annotation_manager.get_stats()
            total = stats["total_events"] or 1
            report = self.scan_data.build_stats_report()
            self._stats_report = report
            self._stats_json = json.dumps(stats, indent=2, default=str)

            def _row(label: str, count: int, max_for_bar: int) -> tuple:
                pct = (count / total) * 100.0 if total else 0.0
                bar = unicode_bar(count, max_for_bar or 1, width=22)
                return (
                    Text(label, no_wrap=True, overflow="ellipsis"),
                    f"{count:,}",
                    f"{pct:5.1f}%",
                    Text(bar, style="cyan"),
                )

            # Summary rows (no bar / 100% style)
            summary = [
                ("Scan", stats["scan_name"], "", ""),
                ("Started", stats["started_at"], "", ""),
                ("Status", stats["status"], "", ""),
                ("BBOT schema", stats["bbot_version"], "", ""),
                ("Total events", f"{stats['total_events']:,}", "100%", unicode_bar(1, 1, 22)),
                ("Vulns", f"{stats['vuln_count']:,}", "", ""),
                ("Findings", f"{stats['finding_count']:,}", "", ""),
                ("Annotations", f"{ann['total']:,}", "", ""),
            ]
            self.item_list = [("summary", k) for k, *_ in summary]
            for lab, val, pct, bar in summary:
                rows.append((
                    Text(str(lab), no_wrap=True),
                    Text(str(val), no_wrap=True, overflow="ellipsis"),
                    Text(str(pct)),
                    Text(bar, style="cyan") if bar else Text(""),
                ))

            # Event types with graphs
            type_items = sorted(stats["event_types"].items(), key=lambda x: -x[1])
            max_type = type_items[0][1] if type_items else 1
            rows.append((Text("— Event types —", style="bold"), Text(""), Text(""), Text("")))
            self.item_list.append(("section", "event_types"))
            for et, cnt in type_items[:25]:
                if self._matches_search(et):
                    self.item_list.append(("event_type", et))
                    rows.append(_row(et, cnt, max_type))

            mod_items = sorted(stats["modules"].items(), key=lambda x: -x[1])
            max_mod = mod_items[0][1] if mod_items else 1
            rows.append((Text("— Top modules —", style="bold"), Text(""), Text(""), Text("")))
            self.item_list.append(("section", "modules"))
            for mod, cnt in mod_items[:15]:
                if self._matches_search(mod):
                    self.item_list.append(("module", mod))
                    rows.append(_row(mod, cnt, max_mod))

            scope_items = sorted(stats["scope_distances"].items(), key=lambda x: x[0] if isinstance(x[0], int) else 0)
            max_scope = max((c for _, c in scope_items), default=1)
            rows.append((Text("— Scope distance —", style="bold"), Text(""), Text(""), Text("")))
            self.item_list.append(("section", "scope"))
            for dist, cnt in scope_items:
                label = f"distance {dist}"
                if self._matches_search(label):
                    self.item_list.append(("scope", dist))
                    rows.append(_row(label, cnt, max_scope))

            if stats.get("severities"):
                sev_order = ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO", "UNKNOWN"]
                sev_items = [(s, stats["severities"][s]) for s in sev_order if s in stats["severities"]]
                max_sev = max((c for _, c in sev_items), default=1)
                rows.append((Text("— Severity —", style="bold"), Text(""), Text(""), Text("")))
                self.item_list.append(("section", "severity"))
                for sev, cnt in sev_items:
                    self.item_list.append(("severity", sev))
                    rows.append(_row(sev, cnt, max_sev))

            if ann.get("by_status"):
                st_items = sorted(ann["by_status"].items(), key=lambda x: -x[1])
                max_st = st_items[0][1] if st_items else 1
                rows.append((Text("— Annotations —", style="bold"), Text(""), Text(""), Text("")))
                self.item_list.append(("section", "annotations"))
                for st, cnt in st_items:
                    self.item_list.append(("ann_status", st))
                    rows.append(_row(f"status:{st}", cnt, max_st))

            if rows:
                packed = list(zip(rows, self.item_list))
                if len(packed) == len(rows):
                    table.add_payload_rows(packed)
                    ordered = table.payloads_in_view_order()
                    if ordered:
                        self.item_list = ordered
                else:
                    table.add_rows(rows)
            detail.set_text("Statistics · charts", report, self._stats_json)
            return

        elif view == "subs":
            items = self.scan_data.iter_subdomain_events()
            for ev in items:
                data = get_data(ev)
                name = str(data if not isinstance(data, dict) else (data.get("host") or data.get("name") or "")).strip()
                if not name:
                    name = str(ev.get("host") or "")
                module = str(ev.get("module", "") or "")
                tags_list = [str(t) for t in (ev.get("tags") or [])]
                tags = ", ".join(tags_list[:8])
                resolved = ev.get("resolved_hosts") or []
                resolved_str = ", ".join(str(h) for h in resolved[:6])
                if not self._matches_search(f"{name} {module} {tags} {resolved_str}"):
                    continue
                self.item_list.append(ev)
                rows.append((
                    Text(name, no_wrap=True, overflow="ellipsis"),
                    Text(module, no_wrap=True, overflow="ellipsis"),
                    str(ev.get("scope_distance", "")),
                    Text(tags, no_wrap=True, overflow="ellipsis"),
                    Text(resolved_str, no_wrap=True, overflow="ellipsis"),
                ))
                if len(rows) >= max_rows:
                    break

        if rows:
            packed = list(zip(rows, self.item_list))
            if len(packed) == len(rows):
                table.add_payload_rows(packed)
                ordered = table.payloads_in_view_order()
                if ordered:
                    self.item_list = ordered
            else:
                table.add_rows(rows)

        if self.item_list:
            idx = old if old is not None and 0 <= old < len(self.item_list) else 0
            table.move_cursor(row=idx)
            self._show_detail(idx)
        else:
            if view == "subs" and not self.scan_data.iter_subdomain_events():
                detail.set_empty(
                    "No DNS_NAME events or subdomains.txt in this scan.\n"
                    "(Try a subdomain-enum style preset.)"
                )
            else:
                detail.set_empty("No items in this view (try search / type / status filter).")

    def _show_detail(self, index: int) -> None:
        if index == self._detail_index and index >= 0:
            return
        self._detail_index = index
        detail = self.query_one("#ws-detail", DetailPane)
        if index < 0 or index >= len(self.item_list):
            detail.set_empty()
            return
        item = self.item_list[index]
        view = self.current_view

        if view == "shots":
            if not isinstance(item, dict):
                detail.set_empty()
                return
            url = str(item.get("_screenshot_url") or "")
            fpath = item.get("_screenshot_path") or ""
            path = Path(fpath) if fpath else None
            caption = format_event_plain(item, self.scan_data)
            if url:
                caption = f"URL: {url}\nFile: {fpath or '(not found)'}\n\n" + caption
            detail.set_screenshot(
                f"Screenshot · {url or 'image'}  (Enter=zoom · o=open file)",
                caption,
                path,
            )
            return

        if view in ("vulns", "findings", "events", "ips", "emails", "social", "subs"):
            if not isinstance(item, dict):
                detail.set_empty()
                return
            plain = format_event_plain(item, self.scan_data)
            data = self.scan_data._get_event_data(item)
            # Richer detail headers for intel views
            if view == "ips":
                ip = str(data) if not isinstance(data, dict) else str(data.get("ip") or data)
                plain = f"IP Address: {ip}\n\n" + plain
            elif view == "emails":
                email = str(data) if not isinstance(data, dict) else str(data.get("email") or data)
                plain = f"Email: {email}\n\n" + plain
            elif view == "social" and isinstance(data, dict):
                plain = (
                    f"Platform: {data.get('platform', '')}\n"
                    f"Profile: {data.get('profile_name', '')}\n"
                    f"URL: {data.get('url', '')}\n\n"
                    + plain
                )
            elif view == "subs":
                name = str(data if not isinstance(data, dict) else (data.get("host") or data)).strip()
                if not name:
                    name = str(item.get("host") or "")
                resolved = item.get("resolved_hosts") or []
                dns_children = item.get("dns_children") or {}
                extra = [f"Subdomain: {name}"]
                if resolved:
                    extra.append(f"Resolved hosts: {', '.join(str(h) for h in resolved)}")
                if isinstance(dns_children, dict) and dns_children:
                    extra.append("DNS children:")
                    for rtype, vals in dns_children.items():
                        if isinstance(vals, (list, set, tuple)):
                            extra.append(f"  {rtype}: {', '.join(str(v) for v in vals)}")
                        else:
                            extra.append(f"  {rtype}: {vals}")
                plain = "\n".join(extra) + "\n\n" + plain
            uuid = item.get("uuid", "")
            ann = self.scan_data.annotation_manager.get_annotation(uuid)
            if ann:
                plain += "\n--- Annotation ---\n"
                plain += f"Status: {ann.get('status', '')}\n"
                plain += f"Priority: {ann.get('priority', '')}\n"
                plain += f"Note: {ann.get('note', '')}\n"
            jtxt = json.dumps(item, indent=2, default=str)
            title = f"{item.get('type', 'EVENT')}"
            if view == "vulns" and isinstance(data, dict):
                sev = normalize_severity(data.get("severity")) or "?"
                title = f"Vuln · {sev}"
                if data.get("name"):
                    title += f" · {data.get('name')}"
                elif data.get("host") or item.get("host"):
                    title += f" · {data.get('host') or item.get('host')}"
            elif view == "findings" and isinstance(data, dict):
                title = f"Finding · {data.get('name') or data.get('host') or item.get('host') or ''}"
            elif view == "subs":
                name = str(data if not isinstance(data, dict) else (data.get("host") or data)).strip()
                title = f"DNS · {name or item.get('host') or ''}"
            elif isinstance(data, dict) and data.get("host"):
                title += f" · {data.get('host')}"
            elif view == "ips":
                title = f"IP · {data if not isinstance(data, dict) else data.get('ip') or data}"
            elif view == "emails":
                title = f"Email · {data if not isinstance(data, dict) else data.get('email') or data}"
            elif view == "social" and isinstance(data, dict):
                title = f"Social · {data.get('platform', '')} · {data.get('profile_name', '')}"
            elif item.get("type") in ("URL", "URL_UNVERIFIED", "HTTP_RESPONSE"):
                title = f"{item.get('type')} · {event_url(item, data) or item.get('host') or ''}"
            detail.set_text(title, plain, jtxt)
        elif view == "stats":
            # Keep full chart report visible; optionally focus a subsection title
            report = self._stats_report or self.scan_data.build_stats_report()
            focus = ""
            if isinstance(item, tuple) and len(item) == 2:
                kind, key = item
                if kind == "event_type":
                    focus = f"Focused: event type {key}\n\n"
                elif kind == "module":
                    focus = f"Focused: module {key}\n\n"
                elif kind == "severity":
                    focus = f"Focused: severity {key}\n\n"
                elif kind == "ann_status":
                    focus = f"Focused: annotation status {key}\n\n"
                elif kind == "scope":
                    focus = f"Focused: scope distance {key}\n\n"
            detail.set_text(
                "Statistics · charts",
                focus + report,
                self._stats_json or json.dumps(self.scan_data.get_statistics(), indent=2, default=str),
            )
        elif view == "config":
            detail.set_text(
                "preset.yml",
                self.scan_data.preset_content or "",
                self.scan_data.preset_content or "",
            )

    def on_data_table_row_highlighted(self, event: DataTable.RowHighlighted) -> None:
        if event.data_table.id == "ws-table":
            self._show_detail(event.cursor_row)

    def on_selectable_table_view_order_changed(self, event: SelectableTable.ViewOrderChanged) -> None:
        if event.table.id != "ws-table":
            return
        if event.reload:
            self._reload_items()
            return
        ordered = event.table.payloads_in_view_order()
        if ordered:
            self.item_list = ordered

    def on_input_changed(self, event: Input.Changed) -> None:
        if event.input.id == "ws-search":
            self.filter_query = event.value or ""
            # Debounce reloads while typing
            if self._search_timer:
                self._search_timer.stop()
            self._search_timer = self.set_timer(self.SEARCH_DEBOUNCE, self._reload_items)

    def on_select_changed(self, event: Select.Changed) -> None:
        if self._updating_filters:
            return
        if event.select.id == "ws-status-filter":
            self.status_filter = str(event.value)
            self._reload_items()
        elif event.select.id == "ws-type-filter":
            val = str(event.value) if event.value is not Select.BLANK else "All"
            if self.current_view == "social":
                self.platform_filter = val
            else:
                self.event_type_filter = val
            self._reload_items()

    def _current_event(self) -> Optional[dict]:
        if self.current_view not in ("vulns", "findings", "events", "ips", "emails", "social", "subs", "shots"):
            return None
        table = self.query_one("#ws-table", SelectableTable)
        i = table.cursor_row
        if i is None or i < 0 or i >= len(self.item_list):
            return None
        item = self.item_list[i]
        return item if isinstance(item, dict) else None

    def action_copy_row(self) -> None:
        """Copy the highlighted table row as TSV (headers + row)."""
        selected = self.get_selected_text()
        if selected:
            notify_copied(self, "selection", selected)
            return
        # Prefer TextArea selection when detail pane has focus selection
        try:
            detail = self.query_one("#ws-detail", DetailPane)
            ta = detail.query_one("#detail-text", TextArea)
            sel = ta.selected_text
            if sel:
                notify_copied(self, "selection", sel)
                return
        except Exception:
            pass
        table = self.query_one("#ws-table", SelectableTable)
        text = table.export_selected_row_markdown()
        if not text.strip():
            # Fallback to plain details if table empty
            detail = self.query_one("#ws-detail", DetailPane)
            notify_copied(self, "details", detail.plain_text)
            return
        notify_copied(self, "row (markdown)", text)

    def action_copy_cell(self) -> None:
        """Copy one cell: current row × last-clicked column (click a cell or header first)."""
        table = self.query_one("#ws-table", SelectableTable)
        lab, val = table.export_selected_cell()
        if not lab and not val:
            self.notify("Select a row and click a column first", severity="warning", timeout=2)
            return
        notify_copied(self, lab or "cell", val)

    def action_copy_table(self) -> None:
        """Copy the entire visible table as a markdown table."""
        table = self.query_one("#ws-table", SelectableTable)
        text = table.export_all_markdown()
        n = table.row_count
        if not text.strip():
            self.notify("Nothing to copy — table is empty", severity="warning", timeout=2)
            return
        notify_copied(self, f"table ({n} rows, markdown)", text)

    def action_copy_json(self) -> None:
        """Copy full JSON of the current item (or mouse selection)."""
        selected = self.get_selected_text()
        if selected:
            notify_copied(self, "selection", selected)
            return
        detail = self.query_one("#ws-detail", DetailPane)
        notify_copied(self, "JSON", detail.json_text or detail.plain_text)

    def action_annotate(self) -> None:
        ev = self._current_event()
        if not ev or ev.get("type") not in ("VULNERABILITY", "FINDING"):
            self.notify("Select a vulnerability or finding to annotate", severity="warning")
            return
        uuid = ev.get("uuid", "")
        current = self.scan_data.annotation_manager.get_annotation(uuid)

        def done(result: Optional[dict]) -> None:
            if result is None:
                return
            if result == {}:
                ok = self.scan_data.annotation_manager.delete_annotation(uuid)
                self.notify(
                    "Annotation cleared" if ok else "Failed to save annotations",
                    severity="information" if ok else "error",
                    timeout=3,
                )
            else:
                ok = self.scan_data.annotation_manager.set_annotation(
                    uuid,
                    status=result.get("status"),
                    priority=result.get("priority"),
                    note=result.get("note"),
                )
                self.notify(
                    "Annotation saved" if ok else "Failed to save annotations",
                    severity="information" if ok else "error",
                    timeout=3,
                )
            self._reload_items()

        self.app.push_screen(AnnotationDialog(ev, current), done)

    def action_mark_fp(self) -> None:
        self._quick_status("false-positive")

    def action_mark_risk(self) -> None:
        self._quick_status("accepted-risk")

    def _quick_status(self, status: str) -> None:
        ev = self._current_event()
        if not ev or ev.get("type") not in ("VULNERABILITY", "FINDING"):
            self.notify("Select a vulnerability or finding", severity="warning")
            return
        uuid = ev.get("uuid", "")
        current = self.scan_data.annotation_manager.get_annotation(uuid)
        ok = self.scan_data.annotation_manager.set_annotation(
            uuid,
            status=status,
            priority=current.get("priority"),
            note=current.get("note"),
        )
        self.notify(
            f"Marked {status}" if ok else "Failed to save annotations",
            severity="information" if ok else "error",
            timeout=3,
        )
        self._reload_items()

    def check_action(self, action: str, parameters: tuple) -> bool | None:
        if action in ("annotate", "mark_fp", "mark_risk"):
            return self.current_view in ("vulns", "findings")
        return True


