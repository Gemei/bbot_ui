#!/usr/bin/env python3
"""
BBOT TUI - Self-installing terminal-based interface for browsing BBOT scan results

This script automatically sets up its own virtual environment and dependencies on first run.
Simply copy this file to any server and run it - no other setup required!
"""

import sys
import os
from pathlib import Path

# Required dependencies
DEPENDENCIES = [
    "textual>=0.47.0",
    "rich>=13.0.0",
    "psutil>=5.9.0",  # For detecting active scan processes (cross-platform)
    "pillow>=10.0.0",  # Screenshot previews (gowitness / WEBSCREENSHOT)
    "textual-image>=0.8.2",  # Sharp in-terminal images (sixel / kitty)
]
# Bump when DEPENDENCIES change so existing venvs reinstall automatically.
DEPS_VERSION = "3"
IMPORT_CHECKS = (
    ("textual", "textual>=0.47.0"),
    ("rich", "rich>=13.0.0"),
    ("psutil", "psutil>=5.9.0"),
    ("PIL", "pillow>=10.0.0"),
    ("textual_image", "textual-image>=0.8.2"),
)


def _venv_paths():
    venv_dir = Path("~/.bbot_ui_venv").expanduser()
    if os.name == "nt":
        venv_python = venv_dir / "Scripts" / "python.exe"
    else:
        venv_python = venv_dir / "bin" / "python"
    return venv_dir, venv_python, venv_dir / ".setup_complete"


def _missing_packages():
    missing = []
    for mod, spec in IMPORT_CHECKS:
        try:
            __import__(mod)
        except ImportError:
            missing.append(spec)
    return missing


def _marker_current(marker_file: Path) -> bool:
    if not marker_file.exists():
        return False
    try:
        first = marker_file.read_text(encoding="utf-8", errors="ignore").splitlines()
        return bool(first) and first[0].strip() == DEPS_VERSION
    except Exception:
        return False


def _write_marker(marker_file: Path) -> None:
    marker_file.parent.mkdir(parents=True, exist_ok=True)
    marker_file.write_text(
        DEPS_VERSION + "\n" + "\n".join(DEPENDENCIES) + "\n",
        encoding="utf-8",
    )


def _pip_install(python_exe: Path) -> None:
    import subprocess
    print("\nInstalling / updating BBOT TUI dependencies...")
    subprocess.run(
        [str(python_exe), "-m", "pip", "install", "-q", "--upgrade", "pip"],
        check=False,
    )
    for dep in DEPENDENCIES:
        print(f"  - {dep}")
        subprocess.run(
            [str(python_exe), "-m", "pip", "install", "-q", dep],
            check=True,
        )
    print("✓ Dependencies ready\n")


def setup_environment():
    """Create venv if needed, install deps, re-exec into venv."""
    script_path = Path(__file__).resolve()
    venv_dir, venv_python, marker_file = _venv_paths()

    print("=" * 60)
    print("BBOT TUI - Setup")
    print("=" * 60)

    if not venv_dir.exists() or not venv_python.exists():
        print(f"\nCreating virtual environment at {venv_dir}")
        import venv
        venv.create(venv_dir, with_pip=True)
        print("✓ Virtual environment created")

    _pip_install(venv_python)
    _write_marker(marker_file)

    print("Launching BBOT TUI...")
    print("=" * 60 + "\n")
    os.execv(str(venv_python), [str(venv_python), str(script_path)] + sys.argv[1:])


# Bootstrap: always land in the venv and ensure current deps (incl. new ones).
if __name__ == "__main__":
    script_path = Path(__file__).resolve()
    venv_dir, venv_python, marker_file = _venv_paths()
    is_venv_python = (
        venv_python.exists()
        and Path(sys.executable).resolve() == venv_python.resolve()
    )

    if not venv_python.exists():
        setup_environment()
        sys.exit(0)

    if not is_venv_python:
        os.execv(str(venv_python), [str(venv_python), str(script_path)] + sys.argv[1:])

    # Running inside the venv: install anything missing (e.g. pillow added later).
    missing = _missing_packages()
    if missing or not _marker_current(marker_file):
        print("=" * 60)
        print("BBOT TUI - Updating dependencies")
        if missing:
            print("Missing:", ", ".join(missing))
        print("=" * 60)
        _pip_install(Path(sys.executable))
        _write_marker(marker_file)

