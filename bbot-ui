    def _intel_counts(self) -> Dict[str, int]:
        """Count unique intel items for nav labels."""
        self._ensure_type_index()
        by = self._events_by_type or {}
        ips = set()
        for t in IP_EVENT_TYPES:
            for ev in by.get(t, []):
                ips.add(str(self.scan_data._get_event_data(ev)))
        emails = set()
        for t in EMAIL_EVENT_TYPES:
            for ev in by.get(t, []):
                emails.add(str(self.scan_data._get_event_data(ev)).lower())
        social_keys = set()
        for t in SOCIAL_EVENT_TYPES:
            for ev in by.get(t, []):
                data = self.scan_data._get_event_data(ev)
                if isinstance(data, dict):
                    social_keys.add(str(data.get("url") or f"{data.get('platform')}:{data.get('profile_name')}"))
                else:
                    social_keys.add(str(data))
        vulns = len(self.scan_data.iter_vulnerability_events())
        findings = len(self.scan_data.iter_finding_events())
        subs = len(self.scan_data.iter_subdomain_events())
        shots = len(self.scan_data.iter_screenshot_events())
        return {
            "vulns": vulns,
            "findings": findings,
            "ips": len(ips),
            "emails": len(emails),
            "social": len(social_keys),
            "subs": subs,
            "shots": shots,
            "events": len(self.scan_data.events),
        }

    def _rebuild_nav(self) -> None:
        """Refresh left nav labels (compact, with counts — no wrap)."""
        ol = self.query_one("#view-list", OptionList)
        c = self._intel_counts()
        try:
            ol.clear_options()
        except Exception:
            while ol.option_count:
                try:
                    ol.remove_option_at_index(0)
                except Exception:
                    break

        # Compact single-line labels so OptionList never wraps mid-entry
        def _cnt(n: int) -> str:
            return f" ({n})" if n else ""

        labels = {
            "vulns": f"1  Vulns{_cnt(c['vulns'])}",
            "findings": f"2  Findings{_cnt(c['findings'])}",
            "ips": f"3  IPs{_cnt(c['ips'])}",
            "emails": f"4  Emails{_cnt(c['emails'])}",
            "social": f"5  Social{_cnt(c['social'])}",
            "subs": f"6  Subdomains{_cnt(c['subs'])}",
            "shots": f"7  Screenshots{_cnt(c['shots'])}",
            "events": f"8  Events{_cnt(c['events'])}",
            "stats": "9  Stats",
            "config": "0  Preset",
        }
        # Always show all views (empty Subdomains is fine)
        for key, _ in VIEWS:
            ol.add_option(Option(labels.get(key, key), id=key))
        keys = self._view_keys()
        if self.current_view in keys:
            try:
                ol.highlighted = keys.index(self.current_view)
            except Exception:
                ol.highlighted = 0
        else:
            ol.highlighted = 0

    def on_unmount(self) -> None:
        try:
            self.query_one("#ws-table", SelectableTable).save_layout()
        except Exception:
            pass
        if self._timer:
            self._timer.stop()
        if self._search_timer:
            self._search_timer.stop()

    def _invalidate_indexes(self) -> None:
        """Drop cached type partitions after new events load."""
        self._events_by_type = None
        self._event_types = None

    def _ensure_type_index(self) -> None:
        if self._events_by_type is not None:
            return
        by_type: Dict[str, List[dict]] = {}
        for ev in self.scan_data.events:
            t = ev.get("type") or "UNKNOWN"
            by_type.setdefault(t, []).append(ev)
        self._events_by_type = by_type
        self._event_types = sorted(by_type.keys())

    def _refresh_type_filter_options(self) -> None:
        """Populate Events type dropdown from scan data."""
        self._ensure_type_index()
        sel = self.query_one("#ws-type-filter", Select)
        options = [("All types", "All")] + [(t, t) for t in (self._event_types or [])]
        current = self.event_type_filter if self.event_type_filter in {o[1] for o in options} else "All"
        self.event_type_filter = current
        self._updating_filters = True
        try:
            sel.set_options(options)
            sel.value = current
        finally:
            self._updating_filters = False

    def _refresh_platform_filter_options(self) -> None:
        """Populate Social platform dropdown from SOCIAL events."""
        self._ensure_type_index()
        platforms = set()
        for t in SOCIAL_EVENT_TYPES:
            for ev in (self._events_by_type or {}).get(t, []):
                data = self.scan_data._get_event_data(ev)
                if isinstance(data, dict) and data.get("platform"):
                    platforms.add(str(data.get("platform")))
        sel = self.query_one("#ws-type-filter", Select)
        options = [("All platforms", "All")] + [(p, p) for p in sorted(platforms)]
        current = self.platform_filter if self.platform_filter in {o[1] for o in options} else "All"
        self.platform_filter = current
        self._updating_filters = True
        try:
            sel.set_options(options)
            sel.value = current
        finally:
            self._updating_filters = False

    def _events_of_types(self, types: frozenset) -> List[dict]:
        self._ensure_type_index()
        out: List[dict] = []
        by = self._events_by_type or {}
        for t in types:
            out.extend(by.get(t, []))
        return out

    def _dedupe_events(self, events: List[dict], key_fn) -> List[dict]:
        """Keep first occurrence of each key (stable order)."""
        seen = set()
        out = []
        for ev in events:
            k = key_fn(ev)
            if k in seen:
                continue
            seen.add(k)
            out.append(ev)
        return out

    def _update_banner(self) -> None:
        status = self.scan_data.get_scan_status()
        n = len(self.scan_data.events)
        name = escape_markup(self.scan_data.scan_name)
        if status == "RUNNING":
            badge = "[bold green]● RUNNING[/]"
        elif status == "FINISHED":
            badge = "[bold blue]✓ FINISHED[/]"
        elif status == "INTERRUPTED":
            badge = "[bold yellow]⚠ INTERRUPTED[/]"
        else:
            badge = f"[dim]{escape_markup(status)}[/]"
        self.query_one("#ws-banner", Static).update(
            f"[bold]{name}[/]  {badge}  ·  {n:,} events  ·  "
            f"[dim]c row · C/Shift+C table · y JSON · t annotate · ? help · q back[/]"
        )

    def _poll(self) -> None:
        # Growth (check_for_updates) or shrink/reuse (file_position past EOF)
        needs_read = self.scan_data.check_for_updates() or self._file_may_have_reset()
        if needs_read:
            added = self.scan_data.load_new_events()
            if added:
                self._invalidate_indexes()
                self._update_banner()
                self._rebuild_nav()
                if self.current_view == "events":
                    self._refresh_type_filter_options()
                elif self.current_view == "social":
                    self._refresh_platform_filter_options()
                self._reload_items()
                return
        # Status-only check (cheap) — avoid full banner rebuild spam
        if self.scan_data.get_scan_status() != "RUNNING" and self._timer:
            self._timer.stop()
            self._timer = None
            self._update_banner()

    def _file_may_have_reset(self) -> bool:
        """True if output.json shrank below last read position."""
        try:
            json_file = self.scan_data.scan_path / "output.json"
            if not json_file.exists():
                return False
            return json_file.stat().st_size < self.scan_data.file_position
        except Exception:
            return False

