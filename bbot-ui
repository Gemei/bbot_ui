def _get_next_available_name(base_path: Path, is_directory: bool = True) -> Path:
    """
    Find the next available name by appending numbers if the path already exists.

    Args:
        base_path: The desired path (file or directory)
        is_directory: True if checking for directory, False for file

    Returns:
        Path that doesn't exist yet (original or numbered variant)

    Examples:
        - scan_name -> scan_name (if doesn't exist)
        - scan_name -> scan_name_1 (if scan_name exists)
        - scan_name.zip -> scan_name_1.zip (if scan_name.zip exists)
    """
    if not base_path.exists():
        return base_path

    # Extract base name and extension
    if is_directory:
        name = base_path.name
        ext = ""
    else:
        # For files, handle extension
        if base_path.name.endswith('.zip'):
            name = base_path.name[:-4]
            ext = ".zip"
        else:
            name = base_path.stem
            ext = base_path.suffix

    # Find next available number
    counter = 1
    while True:
        new_name = f"{name}_{counter}{ext}"
        new_path = base_path.parent / new_name
        if not new_path.exists():
            return new_path
        counter += 1


def create_archive(scan_path: Path) -> tuple[bool, str]:
    """
    Create a ZIP archive from a scan folder.

    Args:
        scan_path: Path to the scan directory to archive

    Returns:
        Tuple of (success, message)
        - success: True if archive created successfully, False otherwise
        - message: Error message if failed, success message if succeeded
    """
    try:
        base_archive_path = scan_path.parent / f"{scan_path.name}.zip"

        # Get next available archive name (handles duplicates)
        archive_path = _get_next_available_name(base_archive_path, is_directory=False)

        # Determine the folder name to use inside the ZIP (match the ZIP filename without .zip)
        zip_internal_folder_name = archive_path.name[:-4]  # Remove .zip extension

        # Create ZIP archive
        with zipfile.ZipFile(archive_path, 'w', zipfile.ZIP_DEFLATED) as zipf:
            # Walk through all files in scan directory
            for root, dirs, files in os.walk(scan_path):
                for file in files:
                    file_path = Path(root) / file
                    # Calculate relative path within the scan folder
                    rel_path = file_path.relative_to(scan_path)
                    # Store with the ZIP's name as the root folder
                    arcname = Path(zip_internal_folder_name) / rel_path
                    zipf.write(file_path, arcname)

        # Verify archive integrity
        with zipfile.ZipFile(archive_path, 'r') as zipf:
            bad_file = zipf.testzip()
            if bad_file is not None:
                # Archive is corrupted
                archive_path.unlink()  # Delete bad archive
                return (False, f"Archive verification failed: {bad_file} is corrupted")

        # Archive is good, now delete the source folder
        shutil.rmtree(scan_path)

        return (True, f"Successfully archived to {archive_path.name}")

    except Exception as e:
        # Clean up incomplete archive if it exists
        if 'archive_path' in locals() and archive_path.exists():
            try:
                archive_path.unlink()
            except:
                pass
        return (False, f"Failed to create archive: {str(e)}")


def _safe_extract_zip(zipf: zipfile.ZipFile, dest_dir: Path) -> None:
    """
    Extract ZIP members under dest_dir only (Zip Slip protection).

    Raises ValueError if any member would escape dest_dir.
    """
    dest_dir = dest_dir.resolve()
    dest_dir.mkdir(parents=True, exist_ok=True)

    for info in zipf.infolist():
        # Normalize member path; reject absolute paths and traversal
        name = info.filename.replace("\\", "/")
        if name.startswith("/") or name.startswith("../") or "/../" in f"/{name}/":
            raise ValueError(f"Unsafe path in archive: {info.filename}")

        target = (dest_dir / name).resolve()
        try:
            target.relative_to(dest_dir)
        except ValueError:
            raise ValueError(f"Unsafe path in archive: {info.filename}") from None

        if info.is_dir():
            target.mkdir(parents=True, exist_ok=True)
            continue

        target.parent.mkdir(parents=True, exist_ok=True)
        with zipf.open(info, "r") as src, open(target, "wb") as out:
            shutil.copyfileobj(src, out)


def extract_archive(archive_path: Path) -> tuple[bool, str]:
    """
    Extract a ZIP archive back to a scan folder.

    Args:
        archive_path: Path to the ZIP archive

    Returns:
        Tuple of (success, message)
        - success: True if extracted successfully, False otherwise
        - message: Error message if failed, success message if succeeded
    """
    extract_path = None
    try:
        # Determine extraction path (remove .zip extension)
        if not archive_path.name.endswith('.zip'):
            return (False, "Not a ZIP file")

        # The folder name inside the ZIP matches the ZIP filename (without .zip)
        scan_name = archive_path.name[:-4]  # Remove .zip
        extract_path = archive_path.parent / scan_name

        # Check if directory already exists
        if extract_path.exists():
            return (False, f"Directory already exists: {scan_name}. Delete or rename it first.")

        # Extract archive safely (no Zip Slip)
        with zipfile.ZipFile(archive_path, 'r') as zipf:
            # Prefer extracting into parent so internal folder name matches ZIP name
            _safe_extract_zip(zipf, archive_path.parent)

        # Verify extraction by checking for output.json
        output_json = extract_path / "output.json"
        if not output_json.exists():
            # Some ZIPs nest under an extra folder — try single top-level dir
            if extract_path.exists():
                shutil.rmtree(extract_path, ignore_errors=True)
            return (False, "Invalid scan archive: output.json not found")

        # Try to read first line to verify it's valid
        try:
            with open(output_json, 'r', encoding='utf-8', errors='ignore') as f:
                first_line = f.readline()
                json.loads(first_line)
        except Exception:
            # output.json is corrupted
            shutil.rmtree(extract_path, ignore_errors=True)
            return (False, "Invalid scan archive: output.json is corrupted")

        # Extraction successful, delete archive
        archive_path.unlink()

        return (True, f"Successfully restored {scan_name}")

    except Exception as e:
        # Clean up incomplete extraction if it exists
        try:
            if extract_path is not None and extract_path.exists():
                shutil.rmtree(extract_path)
        except Exception:
            pass
        return (False, f"Failed to extract archive: {str(e)}")


def get_archive_stats(archive_path: Path) -> dict:
    """
    Get statistics from a ZIP archive without extracting it.

    Args:
        archive_path: Path to the ZIP archive

    Returns:
        Dictionary with keys: size, date, event_count, vuln_count, finding_count
        Returns empty dict on error
    """
    try:
        stat = archive_path.stat()

        stats = {
            'size': stat.st_size,
            'date': datetime.fromtimestamp(stat.st_mtime).strftime("%Y-%m-%d %H:%M"),
            'event_count': 0,
            'vuln_count': 0,
            'finding_count': 0,
        }

        # Try to read output.json from archive to get event counts
        try:
            with zipfile.ZipFile(archive_path, 'r') as zipf:
                # The folder name inside matches the ZIP filename (without .zip)
                scan_name = archive_path.name[:-4]  # Remove .zip
                output_json_path = f"{scan_name}/output.json"

                if output_json_path in zipf.namelist():
                    # Get the compressed file info
                    file_info = zipf.getinfo(output_json_path)
                    uncompressed_size = file_info.file_size

                    with zipf.open(output_json_path, 'r') as f:
                        # For smaller files (<1MB), count exactly
                        if uncompressed_size < 1_000_000:
                            content = f.read().decode('utf-8', errors='ignore')
                            for line in content.split('\n'):
                                line = line.strip()
                                if not line:
                                    continue
                                try:
                                    event = json.loads(line)
                                    event_type = event.get("type", "")
                                    if event_type != "SCAN":
                                        stats['event_count'] += 1
                                    vd, fd = classify_issue_counts(event)
                                    stats['vuln_count'] += vd
                                    stats['finding_count'] += fd
                                except Exception:
                                    continue
                        else:
                            # For larger files, estimate based on sampling
                            sample_size = 100000
                            content = f.read(sample_size).decode('utf-8', errors='ignore')

                            sample_events = 0
                            sample_vulns = 0
                            sample_findings = 0

                            for line in content.split('\n'):
                                line = line.strip()
                                if not line:
                                    continue
                                try:
                                    event = json.loads(line)
                                    event_type = event.get("type", "")
                                    if event_type != "SCAN":
                                        sample_events += 1
                                    vd, fd = classify_issue_counts(event)
                                    sample_vulns += vd
                                    sample_findings += fd
                                except Exception:
                                    continue

                            # Estimate total based on sample ratio
                            ratio = uncompressed_size / sample_size
                            stats['event_count'] = int(sample_events * ratio)
                            stats['vuln_count'] = int(sample_vulns * ratio)
                            stats['finding_count'] = int(sample_findings * ratio)
        except:
            # If we can't read the archive, just return basic stats
            pass

        return stats

    except:
        return {}


