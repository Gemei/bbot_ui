class ConfirmDialog(ModalScreen[bool]):
    """Yes/No confirmation."""

    def __init__(self, message: str):
        super().__init__()
        self.message = message

    def compose(self) -> ComposeResult:
        with Vertical(id="dialog"):
            yield Static(self.message, id="dialog-message", markup=False)
            with Horizontal(id="dialog-buttons"):
                yield Button("Cancel", variant="default", id="cancel")
                yield Button("Confirm", variant="error", id="confirm")

    def on_mount(self) -> None:
        self.query_one("#confirm", Button).focus()

    def on_button_pressed(self, event: Button.Pressed) -> None:
        self.dismiss(event.button.id == "confirm")

    def on_key(self, event) -> None:
        if event.key == "escape":
            self.dismiss(False)
            event.stop()
        elif event.key == "enter":
            # Only confirm when Confirm is focused (not Cancel)
            try:
                focused = self.focused
                if focused is not None and getattr(focused, "id", None) == "confirm":
                    self.dismiss(True)
                    event.stop()
                elif focused is not None and getattr(focused, "id", None) == "cancel":
                    self.dismiss(False)
                    event.stop()
            except Exception:
                self.dismiss(True)
                event.stop()


class AnnotationDialog(ModalScreen[Optional[dict]]):
    """Edit status / priority / notes for a vuln or finding."""

    def __init__(self, event_data: dict, current: dict):
        super().__init__()
        self.event_data = event_data
        self.current = current or {}

    def compose(self) -> ComposeResult:
        etype = self.event_data.get("type", "EVENT")
        data = self.event_data.get("data_json") or self.event_data.get("data") or {}
        host = data.get("host", "") if isinstance(data, dict) else ""
        desc = ""
        if isinstance(data, dict):
            desc = str(data.get("description", ""))[:120]

        with Vertical(id="annotation-dialog"):
            yield Static(f"{etype}  {host}", id="annotation-title", markup=False)
            yield Static(desc, id="annotation-description", markup=False)
            yield Label("Status")
            yield Select(
                options=[(v["label"], k) for k, v in STATUS_OPTIONS.items()],
                value=self.current.get("status", "new"),
                id="status-select",
                allow_blank=False,
            )
            yield Label("Priority (optional)")
            yield Select(
                options=[("(none)", "")] + [(v["label"], k) for k, v in PRIORITY_OPTIONS.items()],
                value=self.current.get("priority", "") or "",
                id="priority-select",
            )
            yield Label("Notes")
            yield Input(
                value=self.current.get("note", "") or "",
                placeholder="Optional notes…",
                id="note-input",
            )
            with Horizontal(id="annotation-buttons"):
                yield Button("Cancel", id="cancel")
                if self.current:
                    yield Button("Clear", variant="warning", id="clear")
                yield Button("Save", variant="primary", id="save")

    def on_mount(self) -> None:
        self.query_one("#save", Button).focus()

    def on_button_pressed(self, event: Button.Pressed) -> None:
        bid = event.button.id
        if bid == "cancel":
            self.dismiss(None)
        elif bid == "clear":
            self.dismiss({})
        elif bid == "save":
            status = self.query_one("#status-select", Select).value
            priority = self.query_one("#priority-select", Select).value
            note = self.query_one("#note-input", Input).value
            self.dismiss({
                "status": status,
                "priority": priority if priority else None,
                "note": note if note else None,
            })

    def on_key(self, event) -> None:
        if event.key == "escape":
            self.dismiss(None)
            event.stop()


