        self.filter_query = ""
        self._timer = None
        self._loading = False
        # Cache: path -> (mtime, size, summary_tuple)
        self._summary_cache: Dict[str, tuple] = {}

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        with Vertical(id="browser-root"):
            yield Static("", id="browser-title")
            with Horizontal(id="browser-toolbar"):
                yield Static("[b]1[/] Scans  [b]2[/] Archives", id="mode-hint")
                yield Input(placeholder="Filter by name…  (/)", id="browser-filter")
                yield Button("Refresh", id="btn-refresh", variant="default")
