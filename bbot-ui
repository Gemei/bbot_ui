        path = escape_markup(str(self.scans_dir))
        mode = "SCANS" if self.mode == "scans" else "ARCHIVES"
        self.query_one("#browser-title", Static).update(
            f"[bold]BBOT[/]  [dim]{path}[/]  ·  [cyan]{mode}[/]"
        )

    def watch_mode(self, mode: str) -> None:
        self._set_title()
        self._rebuild_table()

