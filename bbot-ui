class ScanLoadingScreen(Screen):
    """Load ScanData off the UI thread, then open the workspace."""

    BINDINGS = [
        Binding("escape", "cancel", "Cancel"),
        Binding("q", "cancel", "Cancel"),
    ]

    def __init__(self, scan_path: Path, refresh_interval: float = 2.0):
        super().__init__()
        self.scan_path = scan_path
        self.refresh_interval = refresh_interval
        self._cancelled = False

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        with Vertical(id="loading-root"):
            yield Static(
                f"[bold]Loading scan[/]\n\n"
                f"[cyan]{escape_markup(self.scan_path.name)}[/]\n\n"
                f"[dim]Parsing output.json…[/]\n"
                f"[dim]Press q/Esc to cancel[/]",
                id="loading-msg",
            )
        yield Footer()

    def on_mount(self) -> None:
        self._load_scan()

    @work(thread=True, exclusive=True)
    def _load_scan(self) -> None:
        try:
            data = ScanData(self.scan_path)
            if not self._cancelled:
                self.app.call_from_thread(self._finish_ok, data)
        except Exception as e:
            if not self._cancelled:
                self.app.call_from_thread(self._finish_err, str(e))

    def _finish_ok(self, data: "ScanData") -> None:
        if self._cancelled:
            return
        # Replace this screen with the workspace
        self.app.pop_screen()
        self.app.push_screen(
            WorkspaceScreen(
                self.scan_path,
                self.refresh_interval,
                scan_data=data,
            )
        )

    def _finish_err(self, message: str) -> None:
        if self._cancelled:
            return
        self.notify(f"Failed to load scan: {message}", severity="error", timeout=5)
        self.app.pop_screen()

    def action_cancel(self) -> None:
        self._cancelled = True
        self.app.pop_screen()


